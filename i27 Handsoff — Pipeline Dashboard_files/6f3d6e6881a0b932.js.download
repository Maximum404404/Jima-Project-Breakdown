(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,939836,e=>{"use strict";var t=e.i(651861);let a="c6ebe02b-55c6-41c6-aec8-5f5796b613d6",o={id:"games-review-delta-r1",title:"Games alerts — review-delta & event-scout review",route:"/games",cardId:a,reviewCardId:a,steps:[{title:"Reviewing the Games alerts round",body:"The Games overview now watches your Steam review numbers and the scouting inbox, and raises a banner at the top of the page when something needs a human. This round shipped three checks; this walkthrough shows where each one appears and what would make it fire.\nA banner only shows when live data trips it — an empty spot on a step below means all clear, not a gap. The tour is read-only: nothing in it changes any data.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted part of the screen is what each step is talking about."},{target:'[data-tour="games-overview-stats"]',title:"The numbers the alerts watch",body:"This strip is the overview you already had — wishlists, units, pipeline value and Steam reviews (game count plus demo thumbs up/down). The new checks read the same review numbers, and their banners appear directly above this strip."},{target:'[data-tour="games-alert-zero-reviews"]',title:"Nudge: no reviews a month after launch",body:"A launched title that still has zero Steam reviews 30 days on gets this amber banner — review count gates how visible Steam makes a store page, so a review-ask push is cheap and worth doing.\n(Not showing? No title currently trips it — the check still runs on every visit.)"},{target:'[data-tour="games-alert-demo-sentiment"]',title:"Watch: demo reviews going negative",body:"When a demo’s reviews go net-negative — thumbs-down outnumbering thumbs-up, with at least five reviews so one grumpy reviewer can’t set it off — this banner flags it before the demo feeds marketing or outreach.\n(Not showing? No demo is currently net-negative — the check still runs on every visit.)"},{target:'[data-tour="games-alert-new-events"]',title:"New scouting items to triage",body:"Anything newly landed in the scouting inbox that nobody has looked at yet is listed here by name, so it can’t sit unnoticed. The banner just points at the queue — triage itself happens in the inbox, as before.\n(Not showing? The inbox is clear.)"},{title:"That’s the alerts round",body:"Three checks now run on every overview visit: zero reviews after launch, demo sentiment going negative, and untriaged scouting items — and no banners at all means all clear. (The Gamalytic benchmark feed on the card is deliberately deferred, not missing.)\nNothing in this walkthrough wrote anything. If a threshold or the wording feels off, flag it on the step and it lands straight on the card."}]};(0,t.registerTour)(o),e.s(["gamesReviewDeltaR1Tour",0,o])},401081,e=>{"use strict";var t=e.i(651861);let a="ce49a367-d69a-4838-981b-3eab841677f6",o={id:"games-meeting-agents-r1",title:"Games meeting agents — Round 1 review",route:"/games",cardId:a,reviewCardId:a,steps:[{title:"Reviewing the meeting agents — Round 1",body:"The plan for this card changed shape in review: running the meeting itself belongs to Meeting Mode (which has its own review tour), and the written pre-meeting brief is still to come. What shipped this round is the watching half — the games overview now raises things worth knowing before the weekly games meeting, without anyone having to ask.\nThis walkthrough is read-only: nothing in it changes or files anything.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted area is what each step is talking about."},{target:'[data-tour="games-alerts"]',title:"The overview speaks up before the meeting",body:"When a watcher has something to raise, a warning banner appears here at the very top of the page: a title still at zero Steam reviews a month or more after launch, or demo reviews turned more negative than positive.\nNo banner showing means nothing is currently flagged — quiet is the designed state, not a fault. If one is showing, check its numbers against the stat tiles just below it.",mobileNote:"Alert banners sit above the stat tiles at the top of the page."},{target:'[data-tour="games-alerts-scouting"]',title:"New scouted items ask for a human decision",body:"Newly surfaced scouting items for the games pipeline appear as a notice in the same strip. The module only points at them — deciding what happens to each one stays with a person.\nThis notice also hides itself when nothing is waiting, which is the usual state today. If it is showing, check the item names read sensibly."},{title:"That is Round 1 — and what it deliberately is not",body:"Shipped: the overview now flags zero-review titles, souring demo sentiment and new scouting items ahead of the weekly meeting. Still on the roadmap: the written pre-meeting brief and the after-meeting follow-up, which ride the Meeting Mode rails rather than this page.\nNothing in this walkthrough wrote anything. If a banner said the wrong thing — or stayed quiet when it should have spoken — flag it and it lands on the card."}]};(0,t.registerTour)(o),e.s(["gamesMeetingAgentsR1Tour",0,o])},221963,e=>{"use strict";var t=e.i(651861);let a="c1a707f9-c46b-42b8-b3cd-6a99a74ee212",o={id:"bizdev-meeting-r2",title:"Meeting Mode — Round 2 review",route:"/bizdev/meeting",cardId:a,reviewCardId:a,steps:[{title:"Reviewing Round 2 before Tuesday",body:"This walkthrough covers the eight Round-2 changes to Meeting Mode from the live-meeting feedback. It is read-only: nothing in this tour commits a change to any deal. Use Next/Back to move through it; Esc or ✕ leaves at any time.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted part of the screen is what each step is talking about."},{target:'[data-tour="bizdev-pipeline-switcher"]',title:"The pot switcher actually switches now",body:"Pick a different pot here and the deal list below follows it. The meeting log keeps everything from this meeting, whichever pot you look at. Try switching and switching back — just looking changes nothing.",mobileNote:'The switcher is the dropdown next to the "Meeting Mode" heading at the top.'},{target:'[data-tour="meeting-agenda"]',title:"Closed deals are off the agenda",body:"Won and lost deals no longer appear in the list — there is nothing left to decide on them. Overdue deals still come first, and the order stays put for the whole meeting.",mobileNote:"The agenda is the deal list column — scroll across if the columns are squeezed on your screen."},{target:'[data-tour="meeting-decisions"]',title:"Verbs that look like verbs",body:'These are the meeting\'s action buttons — decline, park, assign an owner, set dates, add a note. They now look pressable and sit under their own "Record a decision" heading, so the room can see where decisions get made.'},{target:'[data-tour="meeting-owner-fact"]',title:"Reassign lives on the owner fact",body:'"Who owns this?" and "hand it to someone else" happen in the same breath, so Reassign now sits right on the owner line. Open it for a look — as long as you don\'t pick anyone, nothing changes.'},{target:'[data-tour="meeting-verb-decline"]',title:"Open the decline flow — safely",body:'Tap Decline once to open the flow and have a look at the next step. Nothing happens until the red "Decline permanently" button — which we won\'t be pressing.'},{target:'[data-tour="meeting-decline-form"]',title:"The one-way door warns you first",body:'(If the warning isn\'t showing, go Back one step and tap Decline first.)\nDeclining a deal is permanent — it moves to closed-lost with no way back — so the form now says so before you commit, and asks why (a required field), so the reason is on the record.\nSeen it? Tap the Cancel button next to "Decline permanently" to back out — nothing was written.'},{title:"Renaming a deal (lives on the pipeline board)",body:"Also new in Round 2, but on the pipeline board rather than in here: open any deal's drawer on /bizdev and a pencil appears next to its name — a mistyped deal name is no longer permanent. Worth a look after this tour; renaming is a real write, so save it for a deal that actually needs it."},{target:'[data-tour="meeting-log"]',title:"Undo, honestly",body:'Made a mistake? Most decisions — moving a stage, assigning an owner, setting a date — show an Undo button here in the log right after you record them.\nThe few that stick (declining, parking, notes) say "No undo" in the log instead, so you know before you rely on it.'},{target:'[data-tour="meeting-verb-note"]',title:"The note field",body:'Add note puts what the room decided straight onto the deal record. Open it for a look if you like — nothing is saved until you press "Save note", and Cancel closes it again.'},{title:"R2 review complete",body:"That's the eight Round-2 changes: the pot switcher fixed, closed deals filtered from the agenda, verbs that look like actions, Reassign on the owner fact, a decline flow that warns before the one-way door, deal renaming from the drawer, honest undo on reversible verbs, and the note field.\nNothing in this walkthrough committed a write. If anything felt wrong, flag it before Tuesday's live meeting."}]};(0,t.registerTour)(o),e.s(["bizdevMeetingR2Tour",0,o])},462849,e=>{"use strict";var t=e.i(651861);let a="4c470393-b850-4ab8-9416-f8f0a4375a49",o={id:"agent-ops-dashboard-r1",title:"Agent Ops — team dashboard & seat costs review",route:"/agent-ops",cardId:a,reviewCardId:a,steps:[{title:"Reviewing the Agent-Ops dashboard",body:"This is the staff mission-control screen for the AI dev seats — every team, every machine, and what they cost. Six things to sign off, ending with the new seat-cost roll-ups.\nThe walkthrough is read-only: nothing in it steers a seat or writes anything. (The small seat list learners see is a separate page, /agent-status — not what we are reviewing here.)",mobileNote:"On a phone this card docks to the bottom edge; the highlighted area is what each step is talking about."},{target:'[data-tour="agent-ops-kpis"]',title:"The fleet numbers",body:"Four numbers for the whole fleet — every team's workers, not just JIMA's: seats online, CLs submitted today, who is waiting on a human, and tokens burned today.\nCheck they square with the sections below them."},{target:'[data-tour="agent-ops-fleet-hosts"]',title:"Fleet hosts — new this round",body:"Every physical machine across both pools, with busy / idle / offline and when it was last seen. Each host also says how it bills: an independent seat, or pooled — sharing one meter with the other web hosts.\nCheck the machines you know are on read as you'd expect."},{target:'[data-tour="agent-ops-burn-chart"]',title:"Burn history, all teams",body:'The token-burn history chart. Its seat picker now covers every team — seats are labelled "Team · Seat" when more than one team is present.\nTry a couple of seats; picking is just a filter, nothing changes.'},{target:'[data-tour="agent-ops-seat-costs"]',title:"Seat costs — plan vs. metered",body:"The seat-cost roll-up (shipped as its own card): what each seat's subscription costs versus what its actual usage would have cost at API prices, over the last 90 days — the badge says which way the money leans.\nIf this panel says it isn't provisioned, that gap is already logged and being fixed separately — flag anything else that looks wrong."},{target:'[data-tour="agent-ops-seats"]',title:"The seat tiles",body:"Each tile is one live seat: its status, context left, what it is doing right now, and — new this round — a Plan line naming the subscription it runs on. The orchestrator gets its own banner above; other teams get their own sections below, with finished workers folding away.\nOpen a thread from any tile to read along — closing it changes nothing."},{target:'[data-tour="agent-ops-activity"]',title:"The activity feed",body:"The live trail from every team's seats: CL submits, build passes and fails, questions and status changes.\nCheck recent events look right and are pinned to the right seat."},{title:"That's the dashboard",body:"Fleet numbers, the host view, burn history, seat costs, live seat tiles and the activity trail. Nothing in this walkthrough wrote anything.\nIf something looked wrong, flag it on the step where you saw it — flags land on the dashboard card for triage."}]};(0,t.registerTour)(o),e.s(["agentOpsDashboardR1Tour",0,o])},294960,e=>{"use strict";var t=e.i(651861);let a="051fca34-921c-4797-b9a6-f2ea88fa622f",o={id:"learner-records-r1",title:"Learner Records — Round 1 review",route:"/learner-records",cardId:a,reviewCardId:a,steps:[{title:"Reviewing Learner Records — Round 1",body:"Round 1 is the operational record per learner: cohort, status, the PDP Doc link, checkpoint reviews, grades, certificates and portfolio links — the delivery team’s working view, in one place.\nDeliberately NOT here yet: sensitive and ILR fields (right-to-work, EDI, eligibility evidence). Those wait for the DPIA sign-off in a later round — if you spot a field like that, flag it.\nThis walkthrough is read-only: nothing in it changes a record.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted area is what each step is talking about."},{target:'[data-tour="learner-records-list"]',title:"The learner list",body:'Every learner record, grouped by cohort so waves read as blocks, each row with a status pill (Active / Paused / Completed / Withdrawn). Staff read and write everything here; "Add learner" starts a record from just an email — no platform account needed yet.\nCheck the grouping and statuses read right for the learners you know.'},{target:'[data-tour="learner-record-sheet"]',title:"Open a record",body:"Click any learner row to open their record sheet — email, cohort, status, and the link out to their PDP Google Doc, which stays the working document; the platform tracks the events around it.\nOpen one now to follow the next steps; Esc or ✕ closes it without changing anything.",mobileNote:"On a phone the record opens as a bottom sheet instead of a side drawer."},{target:'[data-tour="learner-record-checkpoints"]',title:"Checkpoint reviews — the event log",body:'(This lives inside a record — go Back one step and open a learner if nothing is highlighted.)\nEach logged review shows the date, who sat it and headline outcomes. Headlines only, by design — the detail stays in the PDP Doc.\n"Log a review…" opens a small form; we’re only looking — Cancel backs out without saving.'},{target:'[data-tour="learner-record-next-checkpoint"]',title:"The next review, derived",body:'The "Next checkpoint" line comes from the latest review’s scheduled next date — and turns red with "(overdue)" once that date has slipped past today.\n(If nothing is highlighted, this record’s latest review has no next date set — the line only appears when one is scheduled. Try another record or move on.)'},{target:'[data-tour="learner-record-grades"]',title:"Grades",body:'Assessment results — e.g. LoF checks — each with an optional mark, date and notes. Edit and Remove sit on each row for staff; adding uses the "Add grade…" form.\nCheck a real learner’s grades read the way the team recorded them.'},{target:'[data-tour="learner-record-certificates"]',title:"Certificates",body:"Issued certificates with their date and a link to the file (usually on Drive). This is where completion evidence lives instead of a shared folder nobody can find."},{target:'[data-tour="learner-record-portfolio"]',title:"Portfolio links",body:'Curated links to the learner’s work — ArtStation, itch, showreels. Rows a learner added themselves are labelled "added by learner"; staff can add and remove links here.'},{title:"What the learner sees",body:'This page is staff-only. A learner sees their OWN record — same checkpoints, grades, certificates and portfolio — as a "My record" section on their profile page (/profile), read-only except for adding portfolio links. Worth opening /profile as a learner-role check after this review.'},{title:"That’s Round 1",body:"One operational record per learner: the list, the record sheet, checkpoints with a derived next-review date, grades, certificates and portfolio. Sensitive and ILR fields are a later, DPIA-gated round — their absence here is deliberate.\nNothing in this walkthrough wrote anything. Anything off? Flag it on the step and it lands on the card."}]};(0,t.registerTour)(o),e.s(["learnerRecordsR1Tour",0,o])},403878,e=>{"use strict";var t=e.i(651861);let a="d751f589-6f0e-40c6-a1ca-3f503ea49035",o={id:"workstations-v1",title:"Workstations — machines & services",route:"/workstations",cardId:a,reviewCardId:a,steps:[{title:"The single source of truth for the fleet",body:"Workstations replaces the hand-edited #workstations-guide wall post: specs, synced projects, live status, reservations and known quirks for every machine — plus the shared services behind them. The platform holds the truth; Discord stays the ping surface.\nThis walkthrough is read-only: nothing in it changes a machine or files anything.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted area is what each step is talking about."},{target:'[data-tour="workstations-services"]',title:"Shared services, first-class",body:"Perforce (SHODAN), Horde builds and Parsec get their own status rows — half of the old channel's outage traffic was server-level, so machines alone wouldn't replace it. Staff see a pencil to set a status and a note; everyone else reads the same truth."},{target:'[data-tour="workstations-maintenance"]',title:"Scheduled maintenance",body:"Planned windows show here as upcoming. When a window starts, the affected machines and services switch to maintenance by themselves — and switch back when it ends. Discord gets the heads-up, start and all-clear posts automatically, with a link back here.\n(If this section isn't visible, no maintenance is planned and you're not staff — move on.)"},{target:'[data-tour="workstations-machines"]',title:"The machine grid",body:'Every machine, grouped laptops / workstations / infrastructure. Each tile shows the machine\'s status right now (a machine in a maintenance window shows as in maintenance), which projects are synced and ready to launch, reservation chips ("reserved for X, check first" — never a lockout), specs and known quirks.'},{target:'[data-tour="workstations-machine-sheet"]',title:"Open a machine",body:'Click any machine tile to open its detail sheet — full specs, status, reservations, open issues and the known-quirks log (the resolved-issue history that replaces folklore like "L002 actor palette error").\nOpen one now to follow the next step; Esc or ✕ closes it again without changing anything.',mobileNote:"On a phone the detail opens as a bottom sheet instead of a side drawer."},{target:'[data-tour="workstations-report-issue"]',title:"Report an issue — from the machine itself",body:"(This lives inside a machine's sheet — go Back one step and open a machine if nothing is highlighted.)\nAnyone with access can file \"won't launch\"-class issues here. It badges the machine and lands with staff on the platform — no Discord noise — and its resolution becomes a known quirk.\nThe button opens a small form; we're only looking — Esc or Cancel backs out without filing."},{title:"Who can see this: time-boxed grants",body:"Access is a staff role or a time-boxed grant — learners for their bootcamp's duration, X-Devs for their contract. Staff manage grants (extend, cull early) from the Admin area; when a grant lapses, the person keeps their platform account but this module goes dark for them."},{title:"That's Workstations",body:"Truth on the platform, pings on Discord, issues and quirks accumulating on the machine they belong to. Nothing in this walkthrough wrote anything. Spot something wrong while touring? Staff can run this same tour as a review and flag it straight onto the card."}]};(0,t.registerTour)(o),e.s(["workstationsV1Tour",0,o])},68488,e=>{"use strict";var t=e.i(651861);let a="89ef260f-3ebe-456c-aefe-9818a1f8bfbc",o={id:"cff-lifecycle-r1",title:"Project lifecycle — Round 1 review",route:"/finance/cashflow",cardId:a,reviewCardId:a,steps:[{title:"Reviewing project lifecycle (Round 1)",body:"This round gives forecast projects a full lifecycle: four statuses that decide what feeds the forecast, archive and restore for finished projects, a tidy-up prompt, and two date tools — a bulk date shift and a payment-terms rule — both with preview and undo.\nThis walkthrough is read-only: nothing in it changes a project or the forecast.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted area is what each step is talking about."},{target:'[data-tour="cff-projects-panel"]',title:"Projects grouped by lifecycle stage",body:'The Projects panel now groups by status — Active, Proposed, Completed, Declined. The pill on each row says how that status feeds the forecast: Active is always in, Proposed has an on/off toggle, Completed shows "Historical" and Declined shows "Never happened" — neither feeds forward.\nCheck each row\'s pill matches its group heading.'},{target:'[data-tour="cff-project-lifecycle"]',title:"Moving a project between stages",body:"(Nothing highlighted? Expand any project first — the chevron on its row.)\nThe status dropdown at the bottom right moves a project through the four stages. Beside it, finished projects (Completed or Declined) get an archive button; live ones don't — check that a project marked Active offers no archive.\nPicking a status is a real change, so just look."},{target:'[data-tour="cff-shift-dates"]',title:"Shift dates — when a whole project slips",body:'(Open it: with a project expanded, press "Shift dates…".)\nThis moves every planned date in the project by a number of months. Preview is safe — it only lists what would change, before → after, and saves nothing. An applied shift gets a one-click Undo.\nWe won\'t be pressing the confirm button — close the box (Esc or ✕) to back out.'},{target:'[data-tour="cff-payment-terms"]',title:"Payment terms — dates computed, not hand-keyed",body:'(Open it: with a project expanded, press "Payment terms…".)\nSet the rule once — invoiced on the Nth working day of the following month, paid on X-day terms — and the project\'s income dates can be recomputed from it, with the same preview-first flow and Undo as the shift.\nOnly looking here — close the box and nothing is saved.'},{target:'[data-tour="cff-project-cleanup"]',title:"The tidy-up prompt",body:'When a project\'s planned spend all looks finished — everything replaced, paused or in the past — this prompt appears on its row offering "Mark completed & archive" or "Not now".\nBoth buttons record a choice, so press neither. (No prompt showing? No project currently needs tidying — skip this step.)'},{target:'[data-tour="cff-projects-archived"]',title:"Archived, not deleted",body:"Archived projects tuck away into this collapsed row at the bottom of the panel instead of being deleted. Click it open to look — each one keeps its status and figures, with a Restore button that brings it back exactly as it was.\nOpening the list changes nothing. (No Archived row? Nothing is archived yet — skip.)"},{title:"That’s project lifecycle management",body:"Four statuses deciding what feeds the forecast, archive and restore instead of delete, the tidy-up prompt, and two date tools that always preview before they touch anything.\nNothing in this walkthrough wrote a change. Anything felt wrong — a pill on the wrong status, a preview that didn't match — flag it and it lands on the card."}]};(0,t.registerTour)(o),e.s(["cffLifecycleR1Tour",0,o])},925125,e=>{"use strict";var t=e.i(651861);let a="fd7bdef6-603a-4643-8178-21d81cff63b8",o={id:"cff-agent-r1",title:"Finance assistant — Round 1 review",route:"/finance/agent",cardId:a,reviewCardId:a,steps:[{title:"Reviewing the Finance assistant (Round 1)",body:"This round adds the agent layer to the Cashflow Forecast: an Ask tab that answers forecast questions, and an Inbox that turns pasted meeting transcripts into proposals for you to decide on.\nThe governing rule to check on every step: the agent never changes a forecast on its own — every change is approved by a human, into a named scenario. This walkthrough is read-only: nothing in it writes to any forecast.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted area is what each step is talking about."},{target:'[data-tour="cff-agent-ask"]',title:"Ask the forecast a question",body:"Type a question — or tap one of the suggestions — and the answer comes back grounded on the live projections, with a scenario picker to focus it. Asking writes nothing, and there is a 15-second gap between questions.\nAsk something you already know the answer to and check the figures."},{target:'[data-tour="cff-agent-citations"]',title:"Answers show their working",body:"(Nothing highlighted? Ask a question first — this appears under the reply.)\nChips under each answer cite the exact months and lines the answer leaned on. Check the chips actually match what the answer claims — an answer with no chips, or the wrong ones, is worth a flag."},{target:'[data-tour="cff-agent-intake"]',title:"The Inbox: transcripts in, proposals out",body:"Switch to the Inbox tab. Pasting meeting notes here and pressing Extract turns money-shaped commitments into pending proposals below — inbox records only; the forecast itself is untouched.\nOn this step we are only looking: extraction is a real intake, so leave the button alone.",mobileNote:"The Inbox tab is next to Ask at the top of the workspace."},{target:'[data-tour="cff-agent-proposals"]',title:"Every proposal shows its evidence",body:"Each pending proposal carries the verbatim transcript excerpt it came from, and — in green — the exact planning item Approve would create: name, amount, direction, schedule.\nCheck the green item against the quoted words. (An empty list just means nothing is waiting.)"},{target:'[data-tour="cff-agent-approve"]',title:"Approve lands in a named scenario — never Base",body:"Press Approve… on a pending proposal to open the picker: only named scenarios are offered. Base is never an option, so an approval can never touch the shared forecast.\nWe are only looking — Cancel closes it without writing. (Nothing pending? Skip this step.)"},{target:'[data-tour="cff-agent-dismiss"]',title:"Dismiss keeps a note",body:"Dismiss opens a small box asking why (optional) — the note stays with the proposal so bad extractions can be tuned out later.\nCancel backs out without deciding anything. (Nothing pending? Skip this step.)"},{title:"That’s the agent layer",body:"Grounded answers that cite their sources, and transcript proposals that only become forecast entries when a human approves them into a named scenario. Nothing in this walkthrough wrote to a forecast.\nAnything felt wrong — a chip that didn’t match, a diff that mis-read its excerpt — flag it and it lands on the card."}]};(0,t.registerTour)(o),e.s(["cffAgentR1Tour",0,o])},282956,e=>{"use strict";var t=e.i(651861);let a="4f49776f-7aa7-4338-afdb-3c8258094e97",o={id:"games-utm-intake-r1",title:"Games manual intake — Round 1 review",route:"/games/intake",cardId:a,reviewCardId:a,steps:[{title:"Reviewing manual intake (Round 1)",body:"This round adds a manual-intake page to the Games module. UTM link numbers, Epic Games Store totals and store-page traffic have no API — so instead of living in a spreadsheet, they get typed in here weekly and land beside the automatic feeds, always marked MANUAL.\nThis walkthrough is read-only: nothing in it records a number.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted area is what each step is talking about."},{target:'[data-tour="games-intake-composer"]',title:"Where the numbers go in",body:"The Manual intake panel takes entries one product at a time — if it asks you to pick a product, choose one in the switcher at the top (picking changes nothing). Three tabs, one per source: UTM / link CSV, Epic snapshot, Traffic paste. Switching tabs is just looking."},{target:'[data-tour="games-intake-utm"]',title:"UTM numbers arrive as a CSV paste",body:"The first tab takes a CSV pasted straight from the link-tracking tool — the grey example shows the expected columns, and the Default store dropdown covers rows that don't name a store.\nImport rows is the button that records them. We're only looking — leave it alone."},{target:'[data-tour="games-intake-epic"]',title:"Epic snapshot — totals in, change worked out",body:"Open the Epic snapshot tab to see this one. Epic's portal only shows running totals, so that's what you enter — the date plus the cumulative wishlist and units figures — and the page works out the week's change from the previous entry by itself.\nNothing is recorded until Record snapshot, which we won't press."},{target:'[data-tour="games-intake-traffic"]',title:"Traffic paste — the store-page numbers",body:"Open the Traffic paste tab. Date, store, visits and impressions — the weekly store-page numbers for a page with no traffic API.\nRecord entry is the commit button; we're only looking."},{target:'[data-tour="games-intake-entries"]',title:"Every entry lands in this list",body:"Entries appear here newest first: date, store, source, metric, value, the change since the prior entry, and who typed it in. Every row wears the MANUAL badge, so hand-entered numbers never pass for the automatic Steam/UEFN feeds on Metrics.\n(An empty list just means nothing has been entered for this product yet.)"},{title:"That's manual intake",body:"Three ways in for the numbers no API provides — each entry attributed, badged MANUAL, listed here and shown alongside the real feeds on Metrics.\nNothing in this walkthrough recorded anything. Spotted a missing field, confusing copy or a number that wouldn't fit? Flag it and it lands on the card."}]};(0,t.registerTour)(o),e.s(["gamesUtmIntakeR1Tour",0,o])},914771,e=>{"use strict";var t=e.i(651861);let a="aab863d5-13fd-4712-b01f-60d3b29f09df",o={id:"guest-tier-r1",title:"Guest tier & public funnel — R1 review",route:"/wiki",cardId:a,reviewCardId:a,steps:[{title:"R1: the platform foundation for the public funnel",body:"This round is the plumbing under the public funnel: every wiki page now carries a publish switch, and a guest account can only read pages a staff member has explicitly published. Nothing goes public by accident — that is the thing to check.\nThis walkthrough is read-only: nothing in it publishes, unpublishes or edits a page.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted area is what each step is talking about."},{target:'[data-tour="wiki-pages-section"]',title:"Wiki pages wear their draft state",body:'The "Wiki pages" list in the sidebar marks every unpublished page with a small "draft" tag — you see it because you are staff; to a guest account a draft page simply does not exist.\nOpen one of these pages now to follow the next two steps.',mobileNote:"On a phone the sidebar lives in the drawer at the top — tap the chevron next to the search box to open it."},{target:'[data-tour="wiki-publish-badge"]',title:"The page states its visibility",body:'(If nothing is highlighted, pick a page under "Wiki pages" in the sidebar first.)\nNext to the title, the open page says Published (green — guest accounts can read it) or Draft (they cannot). Hovering the badge shows when it was published.'},{target:'[data-tour="wiki-publish-action"]',title:"Publish is an explicit, confirmed act",body:"This staff-only button flips the page between Draft and Published. Click it once and look at the confirm step: it spells out that the page becomes visible to guest accounts.\nWe are only looking — choose Cancel and nothing changes."},{title:"What a guest actually sees",body:"Sign in as a guest and /wiki becomes a different, simpler screen: a flat list of published pages from across the platform — no folder tree, no Drive browsing, no drafts. A staff session can't show that view, so take this as narration: the publish gate you just reviewed is the only door in."},{title:"Where this is heading",body:"That is R1: publish-gating on wiki pages plus a guest read scope — the platform side of the public funnel. Later rounds point at the front of the funnel (a public signup path feeding the CRM); none of that exists yet. Nothing in this walkthrough wrote anything — finish the review to record your verdicts on the card."}]};(0,t.registerTour)(o),e.s(["guestTierR1Tour",0,o])},574126,e=>{"use strict";var t=e.i(651861);let a="b428de59-e342-4e8f-94d9-e106eb7fcc03",o={id:"credentials-vault-r1",title:"Credentials Vault — Round 1 review",route:"/credentials",cardId:a,reviewCardId:a,steps:[{title:"Reviewing the Credentials Vault",body:"This round shipped the reveal-on-request credential store: machine PINs and shared logins live here now instead of pinned chat messages — masked by default, revealed one at a time, every reveal recorded. This is the live vault with the real credentials loaded, so what you see is what the team gets. Approve or Flag each step; nothing in this walkthrough creates, edits or deletes anything.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted area is what each step is talking about."},{target:'[data-tour="vault-browse"]',title:"Which system do you need?",body:"The landing state is deliberately NOT a big password list — you search for a system, or browse the category tiles below. Each tile shows how many items your access covers. Check the categories make sense and the counts look right."},{target:'[data-tour="vault-items"]',title:"Reveal on request: Copy and Show",body:"(Open any category tile and this list appears.) Every value starts masked: Copy puts it on your clipboard; Show reveals it on screen and auto-hides on a countdown — try Show on one item and watch it. The small badges show which tiers can see the item (Staff / Learner / X-Dev)."},{target:'[data-tour="vault-audit-toggle"]',title:"Every reveal is on the record",body:"The Audit log button flips this page to the security feed: every Copy, Show and admin change — who, what and when. Click it and look for the Show you just did at the top, then click it again to come back. Reading the log writes nothing."},{target:'[data-tour="vault-new-credential"]',title:"New credential (admin only)",body:"Admins add items here and choose who sees each one: access tiers (Staff / Learner / X-Dev) or specific named people by email. If you don't see this button you're not an admin — note that and move on. We're only locating it; no need to open the form."},{title:"That's the vault",body:"Search or browse by system, reveal one value at a time, every reveal audited, access controlled by tier or named person. Your Show earlier only added its own audit row — exactly as designed; nothing else was written. If anything looked wrong, flag it — then post the review and the outcome lands on the card."}]};(0,t.registerTour)(o),e.s(["credentialsVaultR1Tour",0,o])},433601,e=>{"use strict";var t=e.i(651861);let a="ac0c34fe-a283-4b96-a620-075340fe0c99",o={id:"permissions-r1",title:"User & module permissions — review",route:"/admin",cardId:a,reviewCardId:a,steps:[{title:"Reviewing user & module permissions",body:"This round put permissions in the admin's hands: who holds which platform role, and which module tabs each person sees — both managed from this Admin Console page.\nThe walkthrough itself is read-only, but the two panels it highlights are live and save on a single click — so check each one by looking, and approve or flag it as you go.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted area is what each step is talking about."},{target:'[data-tour="admin-team-roles"]',title:"Team Roles — every user, one dropdown",body:"Every platform account is listed with its current role badge and a dropdown of all nine global roles: admin, producer, dev, designer, qa, viewer, xdev, learner and guest.\nPicking a role saves immediately, so verify the list READS right — each person on their expected role — without changing anyone. Your own row is deliberately disabled."},{target:'[data-tour="admin-module-access"]',title:"Module Access — which tabs each user sees",body:"New this round: one checkbox per module (PM, Games, BizDev, CRM, Finance) per user. A plain box follows the user's role default; a • marks an explicit override, with ↺ to return it to the default.\nClicking a box writes an override straight away — so again, check the grid by eye. Finance stays locked (with a note below the table) until that module is provisioned."},{title:'One definition of "staff"',body:"Also in this round, behind the scenes: the app's several competing \"who counts as staff\" lists were collapsed into a single source of truth, so Workstations, Agent Ops and the other staff-gated modules can no longer drift apart on who staff are.\nNothing on this page changes because of that — you're signing off the admin surface above, not the code."},{title:"That's the permissions round",body:"Roles and module visibility, both admin-managed from this one page, with role defaults preserved for anyone who was never overridden. Nothing in this walkthrough wrote anything.\nIf a row or toggle looked wrong, flag it on that step — the note lands straight on the review card."}]};(0,t.registerTour)(o),e.s(["permissionsR1Tour",0,o])},323092,e=>{"use strict";var t=e.i(651861);let a="67d0ba86-21df-4b78-83cb-27b7cc266064",o={id:"agent-status-r1",title:"Agent Status — learner-visible seats review",route:"/agent-status",cardId:a,reviewCardId:a,steps:[{title:"Reviewing the learner-visible seat page",body:"This page is new: learners can now see which AI dev seats are up, on a page of its own — the full Agent Ops screen stays staff-only. Two things to sign off: the seat list reads right, and nothing sensitive shows.\nThis walkthrough is read-only — the page has no buttons that write anything.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted area is what each step is talking about."},{target:'[data-tour="agent-status-seats"]',title:"The seat list",body:"Each row is one AI seat: its name, its team, and either Offline or a coarse Working / Idle / Blocked pill — that is the entire row. Finished one-shot workers drop off the list instead of piling up as permanent Offline rows.\nCheck the rows match reality and read at a glance."},{target:'[data-tour="agent-status-page"]',title:"Minimal on purpose — nothing leaks",body:"The highlight now covers the whole page, because this IS the whole page — everything a learner may see. There should be no task names, no transcripts, no costs or token counts anywhere here; that detail lives on the staff-only Agent Ops screen.\nScan it and approve only if nothing beyond seat, team and status is visible."},{title:"That's the whole page",body:"Deliberately small: who is online, at a glance, and nothing else. Nothing in this walkthrough wrote anything. If a row looked wrong or anything more detailed appeared, flag it on the step where you saw it."}]};(0,t.registerTour)(o),e.s(["agentStatusR1Tour",0,o])},782323,247865,e=>{"use strict";var t=e.i(16955),a=e.i(386252),o=e.i(827183),i=e.i(520673);e.i(551137);var s=e.i(707198),n=e.i(52791),r=e.i(135220),h=e.i(162350),d=e.i(563018),l=e.i(651861);let c="564fa8ac-5b78-44ce-8100-d4d2fa8b94ef",g={id:"home-v1",title:"Home — your daily briefing",route:"/",cardId:c,reviewCardId:c,steps:[{title:"Start here every day",body:"Home is the \"start here\" landing for the platform: your cards, the sprint's pulse, your Google Tasks and email activity, and what's newly shipped — one screen instead of five tabs.\nThis walkthrough is read-only: nothing in it changes a card or sends anything.",mobileNote:"On a phone this card docks to the bottom edge; the highlighted area is what each step is talking about."},{target:'[data-tour="home-briefing"]',title:"Your briefing, scoped to a sprint",body:'The greeting line tells you which sprint you\'re looking at — everything below follows the active sprint picked in the top bar. "Open my hand" jumps to the full fanned-card Hand view.'},{target:'[data-tour="home-stats"]',title:"Your hand at a glance",body:"Four numbers: how many cards are in your hand this sprint, how many are actively in progress, how many need attention (blocked or on hold), and how many you've completed."},{target:'[data-tour="home-hand"]',title:"The hand list",body:"Your cards, sharpest first: the ★ focus card leads, anything blocked or on hold comes next, then priority order. Click a row to open the full card — Esc closes it again without changing anything."},{target:'[data-tour="home-pulse"]',title:"Sprint pulse",body:"The whole sprint's progress — everyone's cards, not just yours — with active/blocked/done counts. This is the \"how is the team doing\" number without opening the Kanban."},{target:'[data-tour="home-blockers"]',title:"Blockers & alerts",body:"Anything in YOUR hand that's blocked or on hold surfaces here so it can't hide at the bottom of a list. All clear means exactly that."},{target:'[data-tour="home-tasks"]',title:"Google Tasks, in the briefing",body:"Your Google Tasks lists surface here so the day's non-card work sits next to the card work. Ticking things off is a real write — this tour is just looking."},{target:'[data-tour="home-email"]',title:"Email activity",body:'Recent email activity from the connected inbox, so "did anything land I should know about?" is answered on the same screen.'},{target:'[data-tour="home-whats-new"]',title:"What's new on the platform",body:'Recently shipped platform cards, newest first, each with a one-line source. When a feature has a registered tour, "Show me" walks you through it on the live UI — exactly like the tour you\'re in now.'},{title:"That's Home",body:"Briefing, hand, pulse, blockers, tasks, email, what's new — one screen, read-only until you choose to act. Nothing in this walkthrough wrote anything. Spot something wrong while touring? Staff can run this same tour as a review and flag it straight onto the card."}]};(0,l.registerTour)(g),e.s(["homeV1Tour",0,g],247865);var u=e.i(403878),p=e.i(221963),w=e.i(323092),m=e.i(462849),f=e.i(574126),b=e.i(294960),y=e.i(925125),v=e.i(68488),k=e.i(914771),T=e.i(433601),x=e.i(282956),R=e.i(939836),N=e.i(401081);let A=new Map([g,u.workstationsV1Tour,p.bizdevMeetingR2Tour,w.agentStatusR1Tour,m.agentOpsDashboardR1Tour,f.credentialsVaultR1Tour,b.learnerRecordsR1Tour,y.cffAgentR1Tour,v.cffLifecycleR1Tour,k.guestTierR1Tour,T.permissionsR1Tour,x.gamesUtmIntakeR1Tour,R.gamesReviewDeltaR1Tour,N.gamesMeetingAgentsR1Tour].filter(e=>e.cardId&&e.route).map(e=>[e.cardId,e]));function I({limit:e=8,showViewAll:l=!0}){let{data:c,isPending:g,isError:u}=function(e=8){return(0,h.useQuery)({queryKey:["whats-new",e],queryFn:()=>(0,d.apiGet)(`/api/whats-new?limit=${e}`),staleTime:6e4})}(e);return(0,t.jsx)(r.Panel,{title:"What's new",bodyPadding:c&&c.length>0?"none":"md",action:l?(0,t.jsx)(a.default,{href:"/whats-new",className:"inline-flex items-center gap-1 text-xs font-semibold text-accent-text no-underline outline-none hover:underline focus-visible:underline",children:"View all"}):void 0,children:g?(0,t.jsx)(n.Skeleton,{variant:"row",count:3,label:"Loading what's new…"}):u?(0,t.jsx)("p",{className:"m-0 text-[13px] text-subtle",children:"Couldn’t load what’s new right now."}):c&&0!==c.length?(0,t.jsx)("ul",{className:"m-0 list-none p-0",role:"list",children:c.map(e=>{let i=A.get(e.cardId);return(0,t.jsxs)("li",{className:"flex items-center gap-3 border-t border-default px-4 py-2.5 first:border-t-0",children:[(0,t.jsxs)("div",{className:"min-w-0 flex-1",children:[(0,t.jsxs)("div",{className:"flex items-center gap-2",children:[(0,t.jsx)("span",{className:"min-w-0 truncate text-[13px] font-semibold text-text",children:e.title}),(0,t.jsx)(s.Badge,{size:"sm",variant:"done"===e.status?"success":"info",children:"done"===e.status?"Shipped":"In review"})]}),e.sourceLine&&(0,t.jsx)("p",{className:"m-0 mt-0.5 truncate text-xs text-muted",title:e.sourceLine,children:e.sourceLine})]}),i&&(0,t.jsxs)(a.default,{href:`${i.route}?tour=${i.id}`,className:"inline-flex shrink-0 items-center gap-1.5 rounded border border-default px-2 py-1 font-mono text-[11px] text-muted no-underline transition-colors hover:border-strong hover:text-text","aria-label":`Show me: ${e.title}`,children:[(0,t.jsx)(o.Play,{size:11,"aria-hidden":!0}),"Show me"]})]},e.cardId)})}):(0,t.jsx)(n.EmptyState,{icon:i.Sparkles,size:"sm",title:"Nothing shipped recently",description:"Newly shipped platform features appear here, with a guided tour where one exists."})})}e.s(["default",()=>I],782323)}]);