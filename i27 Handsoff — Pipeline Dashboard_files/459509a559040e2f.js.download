(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,17464,e=>{"use strict";let t={"3d_prop":{key:"3d_prop",label:"3D Prop",color:"#c997fa",stages:[{index:0,name:"Prototype",description:"A prototype demonstrates potential value. Assets are for demonstration purposes, and the game only runs on development PCs.",advice:"This is a throwaway and will most often be remade or removed anyways, so don't get attached to building the perfect thing. Just get it into the engine. Create the minimum required to represent the intended asset as requested by the Product Owner. Speed is the key.",checklist:[{id:"3d_prop_0_check_01",text:"A minimal design specification has been exchanged between Designer and Artist.",hint:'"What am I making and what is its purpose?"'},{id:"3d_prop_0_check_02",text:"Clearly show research, feedback and iterative development towards a final design in Miro.",hint:"Draw 10 in 10 mins, 3 variants in 15 mins, 1 final design in 30 mins"},{id:"3d_prop_0_check_03",text:"Annotated visual development to aid communication with others.",hint:'"It\'s this, not that, because…"'},{id:"3d_prop_0_check_04",text:"Mood boards and silhouettes added to an appropriately named Miro board, embedded on a basic wiki page and any source files (e.g. PureRef) synced up to Perforce depot.",hint:"Duplicate and rename a suitable template wiki page and Miro board, and then embed the Miro to the wiki, and paste the Share URL on the card"},{id:"3d_prop_0_check_05",text:"Discussed and agreed final design (function and visual) with a Design Lead and Dev, plus technical specification (budgets and art direction) with an Art Lead.",hint:null},{id:"3d_prop_0_check_06",text:"A single, fast and simple bounding box imported to engine and sync to Perforce depot.",hint:'A low poly "bounding box" representing the object\'s height, width and depth.'},{id:"3d_prop_0_check_07",text:"Single colour representative texture at the prescribed size, applied to a basic material in-engine.",hint:'"Slap a lambert/phong/blinn on it" and job done.'},{id:"3d_prop_0_check_08",text:"SFX & VFX should not be added at all.",hint:"Existing/placeholder ones are OK to include if already there."},{id:"3d_prop_0_check_09",text:"A bounding box for a collision.",hint:"A quick and simple, best-fit collision, usually automatically generated."},{id:"3d_prop_0_check_10",text:"QA tested inside Unreal Editor (PIE).",hint:"All severity A bugs resolved."},{id:"3d_prop_0_check_11",text:"Required animations are available.",hint:"Stock / representative assets are acceptable. For actions, a montage must be set up."}],standards:[{id:"3d_prop_0_std_01",text:"All files exported to correct location in Perforce.",hint:"Ensure correct folder structure and naming convention before export."},{id:"3d_prop_0_std_02",text:"Model exported as an FBX.",hint:"Ensure FBX.2020.2 or above for UE5."},{id:"3d_prop_0_std_03",text:"Files imported into the Unreal project in the correct location.",hint:"Ensure correct folder structure and naming convention before importing."},{id:"3d_prop_0_std_04",text:"If the 3D prop needs a blueprint — not just a static mesh — this blueprint is made and functional, so that the prop is compatible with its intended use inside of a prototype/test level.",hint:"E.g. a weapon blueprint that can be used to damage enemies, or; a character has appropriate skeletal asset and an animation blueprint so it is able to perform all necessary actions."},{id:"3d_prop_0_std_05",text:"Features of the prop designed and programmed to a matching LoF standard.",hint:"I.e. LoF 0/1/2/3 of the System / Feature / Mechanic pipeline — that pipeline's checklists live on this platform."}]},{index:1,name:"Internal Demo",description:"Demonstrates feature value and identifies areas that need to be polished before the feature can be shown internally. The game runs on target debug platforms with lower than shippable frame rates.",advice:"This mesh should be representative of all aspects of the final design, assets should be easy to swap out, alter or remove for testing purposes. At this stage poly count isn't a primary focus, so long as it can run on a dev machine inside of the engine, a balance of speed and quality is key here.",checklist:[{id:"3d_prop_1_check_01",text:"A mesh is created ready for high poly modelling techniques.",hint:"Mid poly mesh"},{id:"3d_prop_1_check_02",text:"Updates to reference boards added to an appropriately named Miro board, embedded on a basic wiki page and any source files (e.g. PureRef) synced up to Perforce depot.",hint:"Update the existing Miro board with any new material and sync any updated files (e.g. PureRef) to Perforce"},{id:"3d_prop_1_check_03",text:"SFX & VFX placeholders may be added.",hint:"Existing/placeholder ones are OK to include if already there."},{id:"3d_prop_1_check_04",text:"A fast and simple blockout mesh imported to engine and synced to Perforce depot.",hint:"A low-poly or mid-poly mesh that better represents the silhouette of the asset"},{id:"3d_prop_1_check_05",text:"A bounding box for a collision.",hint:"A quick and simple, best-fit collision, usually automatically generated."},{id:"3d_prop_1_check_06",text:"Start and End Sockets added for damage trace, if a weapon.",hint:null},{id:"3d_prop_1_check_07",text:"QA tested inside Unreal Editor (PIE).",hint:'All severity A bugs resolved, with unresolved severity B logged appropriately in the QA backlog and linked to this card — use "+ Log QA item"'},{id:"3d_prop_1_check_08",text:"Basic animations are available.",hint:"Stock / representative assets are acceptable. For actions, a montage must be set up with all notifies and montage sections created and working."}],standards:[{id:"3d_prop_1_std_01",text:"All files exported to correct location in Perforce.",hint:"Ensure correct folder structure and naming convention before export."},{id:"3d_prop_1_std_02",text:"Model exported as an FBX.",hint:"Ensure FBX.2020.2 or above for UE5."},{id:"3d_prop_1_std_03",text:"Files imported into the Unreal project in the correct location.",hint:"Ensure correct folder structure and naming convention before importing."},{id:"3d_prop_1_std_04",text:"If the 3D prop needs a blueprint — not just a static mesh — this blueprint is made and functional, so that the prop is compatible with its intended use inside of a prototype/test level.",hint:"E.g. a weapon blueprint that can be used to damage enemies, or; a character has appropriate skeletal asset and an animation blueprint so it is able to perform all necessary actions."},{id:"3d_prop_1_std_05",text:"Features of the prop designed and programmed to a matching LoF standard.",hint:"I.e. LoF 0/1/2/3 of the System / Feature / Mechanic pipeline — that pipeline's checklists live on this platform."}]},{index:2,name:"External Demo",description:"Demonstrates demo quality (90% assets, not all TRC/TCR requirements). The target frame rate and hardware resource budgets are met.",advice:"The mesh should be entirely representative of the final design and simple placeholder textures should be created to sell the visual of the model. The mesh must comply with Technical Requirements & Performance Budgets. Quality is the key.",checklist:[{id:"3d_prop_2_check_01",text:"High poly version of asset is made.",hint:null},{id:"3d_prop_2_check_02",text:"Asset is placed in Build (game world) for player to see.",hint:"It must have a placed location so it can be experienced."},{id:"3d_prop_2_check_03",text:"A retopologised (retopology workflow) or decimated (nanite workflow), game ready mesh is created and is in engine.",hint:null},{id:"3d_prop_2_check_04",text:"Mesh will have high quality bakes, and show attributes from the high poly sculpt.",hint:null},{id:"3d_prop_2_check_05",text:"Game ready or decimated nanite poly mesh has been properly UV unwrapped.",hint:"This requires custom UV unwrapping (No automatic) and adheres to performance budgets."},{id:"3d_prop_2_check_06",text:"Representative textures using generated/smart materials in substance.",hint:"Quickly apply pre-made auto-materials, don't spend time authoring ones for this prop at this stage."},{id:"3d_prop_2_check_07",text:"Basic material set up in the engine with correct texture maps.",hint:"A quick and standard BNAO (Base, Normal, AO) packed map, which derives from the correct master material."},{id:"3d_prop_2_check_08",text:"Representative collision generated and all significant collision optimisations accounted for.",hint:"Simple collisions generated, correct collision channel preset used (not a custom one!)"},{id:"3d_prop_2_check_09",text:"A minimal design document is present on a relevantly named and located wiki page, with embedded Miro board.",hint:"A simple short summary of the prop and its use and effects, if applicable."},{id:"3d_prop_2_check_10",text:"Updates to reference boards added to an appropriately named Miro board, embedded on a basic wiki page and any source files (e.g. PureRef) synced up to Perforce depot.",hint:"Update the existing Miro board with any new material and sync any updated files (e.g. PureRef) to Perforce"},{id:"3d_prop_2_check_11",text:"SFX & VFX are required but suitable placeholders OK.",hint:"Existing/placeholder ones are OK to include if already there."},{id:"3d_prop_2_check_12",text:"Asset added to the QA master checklist template.",hint:"Location of asset in game, how to test, expected results etc."},{id:"3d_prop_2_check_13",text:"QA tested inside Build.",hint:'All severity A & B bugs resolved, with unresolved severity C logged appropriately in the QA backlog and linked to this card — use "+ Log QA item".'},{id:"3d_prop_2_check_14",text:"Basic animations are set up and entirely functional.",hint:"Stock / representative assets are acceptable. For actions, a montage must be set up with all notifies and montage sections created and working."},{id:"3d_prop_2_check_15",text:"UI Icon for inventory and slots in game.",hint:"A quick render is acceptable at this stage."},{id:"3d_prop_2_check_16",text:"If the Asset is intended for a specific continent, add it to the relevant Collection for that continent.",hint:"This only applies to environmental props. Weapons/offhands/accessories do not need this."}],standards:[{id:"3d_prop_2_std_01",text:"All files exported to correct location in Perforce.",hint:"Ensure correct folder structure and naming convention before export."},{id:"3d_prop_2_std_02",text:"Model exported as an FBX.",hint:"Ensure FBX.2020.2 or above for UE5."},{id:"3d_prop_2_std_03",text:"Files imported into the Unreal project in the correct location.",hint:"Ensure correct folder structure and naming convention before importing."},{id:"3d_prop_2_std_04",text:"If the 3D prop needs a blueprint — not just a static mesh — this blueprint is made and functional, so that the prop is compatible with its intended use inside of a prototype/test level.",hint:"E.g. a weapon blueprint that can be used to damage enemies, or; a character has appropriate skeletal asset and an animation blueprint so it is able to perform all necessary actions."},{id:"3d_prop_2_std_05",text:"Features of the prop designed and programmed to a matching LoF standard.",hint:"I.e. LoF 0/1/2/3 of the System / Feature / Mechanic pipeline — that pipeline's checklists live on this platform."}]},{index:3,name:"Ship",description:"Ready to be deployed. It passes all TRC/TCR tests and has no memory leaks. All assets are polished.",advice:"Quality is key, this is the final pass on the release asset and will need to be reviewed thoroughly by a third party. Ensure all criteria inside of Technical Requirements & Performance Budgets are met.",checklist:[{id:"3d_prop_3_check_01",text:"Polished textures and material shader(s) are produced to a high standard.",hint:"All placeholder textures replaced with final textures."},{id:"3d_prop_3_check_02",text:"Advanced materials set up in engine that are assigned as material instances which are derived from master materials within the material hierarchy.",hint:null},{id:"3d_prop_3_check_03",text:"Final Media section of miro contains a render of the complete textured asset.",hint:"An image that demonstrates the end appearance of the asset."},{id:"3d_prop_3_check_04",text:"Texture budgets met and reasonably optimised within performance budgets.",hint:"Texture size clamping pass."},{id:"3d_prop_3_check_05",text:"If required, cloth sim has been generated in engine, tweaks have been made to ensure they work correctly and optimised within performance budgets.",hint:null},{id:"3d_prop_3_check_06",text:"If required, hair or fur (strands and cards) have been tested and optimised within performance budgets.",hint:null},{id:"3d_prop_3_check_07",text:"LODs have been tested and optimised within performance budgets.",hint:null},{id:"3d_prop_3_check_08",text:"Final SFX & VFX are required, replacing any placeholders.",hint:"Everything needed is present to sell the effect to players."},{id:"3d_prop_3_check_09",text:"UI Icon for inventory and slots.",hint:"A final representative render is required at this stage."},{id:"3d_prop_3_check_10",text:"QA tested inside Build.",hint:'All severity A, B & C bugs resolved, with unresolved severity D logged appropriately in the QA backlog and linked to this card — use "+ Log QA item".'},{id:"3d_prop_3_check_11",text:"Content Compliance with Age Ratings confirmed (IARC).",hint:"Confirm the asset meets the required age rating thresholds (e.g., gore, violence, sexuality, nudity)."},{id:"3d_prop_3_check_12",text:"Licensing and Accreditation confirmed.",hint:"Ensure all licensing and accreditation are secured, documented in the wiki, and credits are properly attributed."}],standards:[{id:"3d_prop_3_std_01",text:"All files exported to correct location in Perforce.",hint:"Ensure correct folder structure and naming convention before export."},{id:"3d_prop_3_std_02",text:"Model exported as an FBX.",hint:"Ensure FBX.2020.2 or above for UE5."},{id:"3d_prop_3_std_03",text:"Files imported into the Unreal project in the correct location.",hint:"Ensure correct folder structure and naming convention before importing."},{id:"3d_prop_3_std_04",text:"If the 3D prop needs a blueprint — not just a static mesh — this blueprint is made and functional, so that the prop is compatible with its intended use inside of a prototype/test level.",hint:"E.g. a weapon blueprint that can be used to damage enemies, or; a character has appropriate skeletal asset and an animation blueprint so it is able to perform all necessary actions."},{id:"3d_prop_3_std_05",text:"Features of the prop designed and programmed to a matching LoF standard.",hint:"I.e. LoF 0/1/2/3 of the System / Feature / Mechanic pipeline — that pipeline's checklists live on this platform."},{id:"3d_prop_3_std_06",text:"All animations are set up and entirely functional.",hint:"Only finalised specific assets are acceptable. For actions, a montage must be set up with all notifies and montage sections created and working."}]},{index:4,name:"Console Ship",description:"Ready to be deployed to consoles. It passes all TRC/TCR tests.",advice:"Test on the console, not on PC builds.",checklist:[{id:"3d_prop_4_check_01",text:"Passes relevant TRC checks for shipping on the Target Platform(s).",hint:"Fails if TRC fails, e.g. memory leak."},{id:"3d_prop_4_check_02",text:"QA tested inside Build on Target Platform(s).",hint:'All severity A, B & C bugs resolved, with unresolved severity D logged appropriately in the QA backlog and linked to this card — use "+ Log QA item".'}],standards:[]}]},level:{key:"level",label:"Level",color:"#92f876",stages:[{index:0,name:"Prototype",description:"A prototype demonstrates potential value. Assets are for demonstration purposes, and the game only runs on development PCs.",advice:"Quickly demonstrating the key elements of the design in a format that can easily be changed in very major ways is the purpose of producing a prototype like this. Speed is the key.",checklist:[{id:"level_0_check_01",text:"All steps relevant to the current LoF in the Level Design Pipeline (Miro) have been evidenced.",hint:null,link:{label:"Level Design Pipeline (Miro)",url:"https://miro.com/app/board/uXjVMubsf6s=/?moveToWidget=3458764561575052016&cot=14"}},{id:"level_0_check_02",text:"Level design board in relevant level Miro.",hint:null},{id:"level_0_check_03",text:'Design intent, story, main areas described, as well as "What it is" and "Why it\'s cool".',hint:null},{id:"level_0_check_04",text:"Consideration for Story, Setting and Journey, plus core mechanics and level metrics.",hint:null},{id:"level_0_check_05",text:"Level layout sketch with golden path, combat encounters, checkpoints, traps, vistas, key treasures, NPC interactions, bosses, and any points of interest.",hint:null},{id:"level_0_check_06",text:"Clearly incorporated early stage feedback from a designer to improve the design.",hint:null},{id:"level_0_check_07",text:"Whitebox blockout representing the massing of the level in the game world.",hint:null}],standards:[]},{index:1,name:"Internal Demo",description:"Demonstrates feature value and identifies areas that need to be polished before the feature can be shown internally. The game runs on target debug platforms with lower than shippable frame rates.",advice:"This stage is the first point at which the level and quest will be playable. Ensure the critical path gives a good representation of the player experience. It uses blockout assets and side-areas have no detail. The player experience (pacing, feel, etc.) is established at this stage. Speed is key here.",checklist:[{id:"level_1_check_01",text:"All steps relevant to the current LoF in the Level Design Pipeline (Miro) have been evidenced.",hint:null,link:{label:"Level Design Pipeline (Miro)",url:"https://miro.com/app/board/uXjVMubsf6s=/?moveToWidget=3458764561575052016&cot=14"}},{id:"level_1_check_02",text:"Grey box prototype in a separate level within the correct levels folder.",hint:null},{id:"level_1_check_03",text:"Uses the level prototyping tools (BP_Boundary, BP_Vaultable etc.) to ensure traversal.",hint:null},{id:"level_1_check_04",text:"Heights of surfaces in the level adhere to our metrics (Use BP_HeightRuler).",hint:null},{id:"level_1_check_05",text:"Key quest NPCs, enemies and interactions are present using placeholders.",hint:null},{id:"level_1_check_06",text:"Basic or fake functionality where required to represent the player experience, e.g. doors, destructables, level events, etc.",hint:null},{id:"level_1_check_07",text:"Clearly incorporated feedback from a designer and playtest(s) to improve the design.",hint:null},{id:"level_1_check_08",text:"Demonstrates effective use of level design principles.",hint:null},{id:"level_1_check_09",text:"1–3 'Beautiful Corners': small sections of the map that have been fleshed out with environment pallet assets, indicative of the look of the finished level.",hint:null}],standards:[]},{index:2,name:"External Demo",description:"Demonstrates demo quality (90% assets, not all TRC/TCR requirements). The target frame rate and hardware resource budgets are met.",advice:"As this is the penultimate step, and the first which people outside of the studio will experience; it's important to have the flow and feel of the experience nailed down, even if visuals and balance are not yet final. Speed and quality is key here.",checklist:[{id:"level_2_check_01",text:"All steps relevant to the current LoF in the Level Design Pipeline (Miro) have been evidenced.",hint:null,link:{label:"Level Design Pipeline (Miro)",url:"https://miro.com/app/board/uXjVMubsf6s=/?moveToWidget=3458764561575052016&cot=14"}},{id:"level_2_check_02",text:"Level present in the game world, no part(s) left in dev folders.",hint:null},{id:"level_2_check_03",text:"Asset pass to replace the approved greybox design with agreed assets.",hint:null},{id:"level_2_check_04",text:"All interactions, NPCs and enemies are working as intended.",hint:null},{id:"level_2_check_05",text:"All severity A & B bugs resolved, with unresolved severity C bugs logged in the QA backlog and linked to this card.",hint:'Log QA items and automatically attach them to this card with "+ Log QA item".'},{id:"level_2_check_06",text:"There are no obvious ways for the player to escape the level bounds.",hint:null},{id:"level_2_check_07",text:"Ensure that world partition navigation has been built.",hint:null},{id:"level_2_check_08",text:"The level adheres to the goals and standards of Samsara Art Direction and is consistent with the direction established in existing levels.",hint:null},{id:"level_2_check_09",text:"Ensure that any changes or additions to the level design are reflected in the Area List and Design Intent sections of the relevant Wiki Page.",hint:null},{id:"level_2_check_10",text:"Relevant checks for the level have been added to the QAMC.",hint:null}],standards:[]},{index:3,name:"Ship",description:"Ready to be deployed. It passes all TRC/TCR tests and has no memory leaks. All assets are polished.",advice:"For the final pass, visuals and balance need to be tuned, ensuring the final product's quality. Quality is key here.",checklist:[{id:"level_3_check_01",text:"All steps relevant to the current LoF in the Level Design Pipeline (Miro) have been evidenced.",hint:null,link:{label:"Level Design Pipeline (Miro)",url:"https://miro.com/app/board/uXjVMubsf6s=/?moveToWidget=3458764561575052016&cot=14"}},{id:"level_3_check_02",text:"Final assets (3D and audio) are in place, ensuring no placeholder assets remain.",hint:null},{id:"level_3_check_03",text:"All severity A, B & C bugs resolved, with unresolved severity D logged appropriately in the QA backlog and linked to this card.",hint:'Log QA items and automatically attach them to this card with "+ Log QA item".'},{id:"level_3_check_04",text:"All level areas have been packaged into separate Packed Level Actors.",hint:null},{id:"level_3_check_05",text:"Ensure that world partition navigation has been built.",hint:null},{id:"level_3_check_06",text:"Ensure that any changes or additions to the level design are reflected in the Area List and Design Intent sections of the relevant Wiki Page.",hint:null},{id:"level_3_check_07",text:"Content Compliance with Age Ratings confirmed (IARC).",hint:"Confirm the asset meets the required age rating thresholds (e.g., gore, violence, sexuality, nudity)."},{id:"level_3_check_08",text:"Licensing and Accreditation confirmed.",hint:"Ensure all licensing and accreditation are secured, documented in the wiki, and credits are properly attributed."}],standards:[]}]},enemies:{key:"enemies",label:"Enemies",color:"#c997fa",stages:[{index:0,name:"Prototype",description:"A prototype demonstrates potential value. Assets are for demonstration purposes, and the game only runs on development PCs.",advice:"This is a throwaway and will most often be remade or removed anyways, so don't get attached to building the perfect thing. Just get it into the engine. Create the minimum required to represent the intended asset as requested by the Product Owner. Speed is the key.",checklist:[{id:"enemies_0_check_01",text:"Enemies have a working blueprint; those based on an existing avatar are represented by an existing mesh for that avatar. Other enemies use a Mannequin or Metahuman (preferred) mesh to represent the enemy type. A quick colour tint or texture swap distinguishes this enemy from the duplicate.",hint:null},{id:"enemies_0_check_02",text:"Can move, climb and attack with placeholder animations at least.",hint:null},{id:"enemies_0_check_03",text:"Placeholder stats, equipment and skills that are available and functional.",hint:"E.g. accessories (headgear, other slots), spells (Mantra & Mudra), weapons (mesh, BP, moveset anims) and offhand (mesh, BP, effect) — these do not need to be tuned for balance so use what works to prove potential value, as this will be changed."},{id:"enemies_0_check_04",text:"Entry on the wiki plus associated miro board include: Wiki — miro embedded only; Miro — design intent (purpose, colourway, equipment), key factors (range, movement, timing, concurrency, priority, habit disruption), where they are intended to be used, relative difficulty, traits and behaviours, plus any design and/or reference materials.",hint:null},{id:"enemies_0_check_05",text:"Traits, Behaviours are demonstrable on a developers' machine in a test level, in dev folders.",hint:null}],standards:[]},{index:1,name:"Internal Demo",description:"Demonstrates feature value and identifies areas that need to be polished before the feature can be shown internally. The game runs on target debug platforms with lower than shippable frame rates.",advice:'A quick and dirty implementation that allows the enemy to fulfil the role it was designed for in a basic capacity. Think: "Dirt Road". Speed is the key.',checklist:[{id:"enemies_1_check_01",text:"If there is an updated character model to replace a placeholder, the new character model has now replaced the placeholder.",hint:null},{id:"enemies_1_check_02",text:"Enemy has the right type of equipment and skills that match the design and are no longer placeholders.",hint:null},{id:"enemies_1_check_03",text:"Environmental Factors (destructables in env, minions, etc.) are added if designed.",hint:null},{id:"enemies_1_check_04",text:"Attributes and statistics have been set based on the enemy's role in encounters and how far along it appears in the game's progression.",hint:"It should be appropriately strong for where it appears and the role it plays."},{id:"enemies_1_check_05",text:"The enemy can be pacified and executed, and the enemy's pacification threshold changes as it is designed to based on threshold modifier(s).",hint:null},{id:"enemies_1_check_06",text:"Unique AI Behaviour and trait blueprint code refactored (no spaghetti and no unnecessary code duplication) and demonstrable in a test map on any machine.",hint:null},{id:"enemies_1_check_07",text:"Vanquish threshold modifiers are established and present in the design.",hint:null},{id:"enemies_1_check_08",text:"All severity A bugs resolved, with unresolved severity B logged appropriately in the QA backlog and linked to this card.",hint:'Log QA items and automatically attach them to this card with "+ Log QA item".'}],standards:[]},{index:2,name:"External Demo",description:"Demonstrates demo quality (90% assets, not all TRC/TCR requirements). The target frame rate and hardware resource budgets are met.",advice:'The enemy should be effectively fully-functional at this stage, lacking only final polish and updates from playtesting. Think: "Gravel Road". Speed and quality is the key.',checklist:[{id:"enemies_2_check_01",text:"The enemy uses the correct appearance, in adherence with our art direction goals and standards.",hint:"E.g. character model (mesh), skin (tone, tattoos, scars, imperfections, dirt, ageing), hair style (colour, style), clothing (colourway, unique cloth and hard surfaces)."},{id:"enemies_2_check_02",text:"Weapons and accessories have passed LoF 2.",hint:null},{id:"enemies_2_check_03",text:"Equipment and skills that are available and functional as per design.",hint:"E.g. accessories (headgear, other slots), spells (Mantra & Mudra), weapons (mesh, BP, moveset anims) and offhand (mesh, BP, effect) — these do not need to be perfectly tuned for balance so use what works to demonstrate demo quality, as this is most likely their final configuration."},{id:"enemies_2_check_04",text:"Any required SFX & VFX for actions are present and represent the final design direction, no longer placeholders.",hint:"Foley, death scream, staggered/stunned cry, traits, behaviours, other special actions."},{id:"enemies_2_check_05",text:"Revised stats (attributes & statistics), encounter design (pacing, scenarios, placed in world), loot (tuned drop rates, consumables drop only), perception (sight, hearing), pacification threshold (pacification threshold events).",hint:"E.g. interrupting the Asura bow."},{id:"enemies_2_check_06",text:"QAMC entry (checks for traits & behaviours, appearance and spells, equipment of the enemy, loot drops, etc.)",hint:null},{id:"enemies_2_check_07",text:"Enemy can be found in a build.",hint:null},{id:"enemies_2_check_08",text:"Entry on the wiki plus associated miro board include: Wiki — design intent (purpose), miro embedded, traits (shared), individual appearance (colourway, equipment) and behaviours for enemy types. Miro — where they are intended to be used, relative difficulty, traits and behaviours, plus any design and/or reference materials.",hint:null},{id:"enemies_2_check_09",text:"All severity A & B bugs resolved, with unresolved severity C logged appropriately in the QA backlog and linked to this card.",hint:'Log QA items and automatically attach them to this card with "+ Log QA item".'}],standards:[]},{index:3,name:"Ship",description:"Ready to be deployed. It passes all TRC/TCR tests and has no memory leaks. All assets are polished.",advice:'This is the final pass on the enemy, with all final assets implemented and bugs fixed. Think: "Concrete Road". Quality is the key.',checklist:[{id:"enemies_3_check_01",text:"Unique Movesets (difficult uniques), and increasing complexity of combos have been added if designed.",hint:null},{id:"enemies_3_check_02",text:"Any bugs identified in the enemy's behaviour, design, animation or art have been fixed.",hint:null},{id:"enemies_3_check_03",text:"Final, polished animations have been implemented.",hint:null},{id:"enemies_3_check_04",text:"Final art assets for this enemy have been implemented, including audio (e.g. boss music and combat barks) and animation.",hint:null},{id:"enemies_3_check_05",text:"The enemy's difficulty has been balanced to an appropriate level, both when faced alone and as part of groups (unless it is intended to only ever be fought alone).",hint:null},{id:"enemies_3_check_06",text:"Updated design documentation that has complete details of the enemy's final implementation.",hint:null},{id:"enemies_3_check_07",text:"All severity A, B & C bugs resolved, with unresolved severity D logged appropriately in the QA backlog and linked to this card.",hint:'Log QA items and automatically attach them to this card with "+ Log QA item".'},{id:"enemies_3_check_08",text:"Content Compliance with Age Ratings confirmed (IARC).",hint:"Confirm the asset meets the required age rating thresholds (e.g., gore, violence, sexuality, nudity)."},{id:"enemies_3_check_09",text:"Licensing and Accreditation confirmed.",hint:"Ensure all licensing and accreditation are secured, documented in the wiki, and credits are properly attributed."}],standards:[]}]},quest_dialogue:{key:"quest_dialogue",label:"Quest & Dialogue",color:"#92f876",stages:[{index:0,name:"Prototype",description:"A prototype demonstrates potential value. Assets are for demonstration purposes, and the game only runs on development PCs.",advice:"Quickly demonstrating the key elements of the design in a format that can easily be changed in very major ways is the purpose of producing a prototype like this. Speed is the key.",questChecklist:[{id:"quest_dialogue_0_quest_01",text:"Quest title, summary in Miro.",hint:null},{id:"quest_dialogue_0_quest_02",text:"How it starts (hook) and how it concludes (ending) present a clear moral dilemma.",hint:null},{id:"quest_dialogue_0_quest_03",text:"What the player must do in order to complete (numbered steps).",hint:null},{id:"quest_dialogue_0_quest_04",text:"Motivations and emotions have been identified.",hint:'"What motivates the player to pursue this quest?", "What emotions is it intended to evoke?"'},{id:"quest_dialogue_0_quest_05",text:"Any functionality unique to this quest is prototyped in engine.",hint:null}],dialogueChecklist:[{id:"quest_dialogue_0_dial_01",text:"Dialogue in flow chart in Miro.",hint:null},{id:"quest_dialogue_0_dial_02",text:"Dialogue is functional only and communicates the information the player needs to complete the quest without style or flavour.",hint:'E.g. "Bring me a Bilva fruit", "Meet me at the mountain", etc.'}],standards:[]},{index:1,name:"Internal Demo",description:"Demonstrates feature value and identifies areas that need to be polished before the feature can be shown internally. The game runs on target debug platforms with lower than shippable frame rates.",advice:"This stage is the first point at which the level and quest will be playable. Ensure the critical path gives a good representation of the player experience. It uses blockout assets and side-areas have no detail. The player experience (pacing, feel, etc.) is established at this stage. Speed is key here.",questChecklist:[{id:"quest_dialogue_1_quest_01",text:"Quest title and summary in Miro have been updated based on feedback agreed with a designer.",hint:null},{id:"quest_dialogue_1_quest_02",text:"Any major branches in the quest, and what changes when these branches are explored by the player, are clear in the flow chart.",hint:null},{id:"quest_dialogue_1_quest_03",text:"NPC character sheet for those involved is on the wiki — created new, or updated if the NPC already exists.",hint:"Any format the wiki picks up and renders (Google Doc, Miro, wiki text) — the wiki view is what counts, not the tool."},{id:"quest_dialogue_1_quest_04",text:"The Quest can be started and finished in-game, and any unique behaviour is demonstrable in the game-world.",hint:"Not necessarily the main map, an editor test map will suffice; does not require quest saving progress."},{id:"quest_dialogue_1_quest_05",text:"If the quest requires an NPC, a placeholder will be in-game.",hint:null}],dialogueChecklist:[{id:"quest_dialogue_1_dial_01",text:"Dialogue in flow chart in Miro styled as a conversation.",hint:null},{id:"quest_dialogue_1_dial_02",text:"Major branches in the dialogue are present and dialogue choices link to karma events.",hint:null},{id:"quest_dialogue_1_dial_03",text:"Any key dialogue required to start and finish the quest is implemented into the game.",hint:null}],standards:[]},{index:2,name:"External Demo",description:"Demonstrates demo quality (90% assets, not all TRC/TCR requirements). The target frame rate and hardware resource budgets are met.",advice:"As this is the penultimate step, and the first which people outside of the studio will experience; it's important to have the flow and feel of the experience nailed down, even if visuals and balance are not yet final. Speed and quality is key here.",questChecklist:[{id:"quest_dialogue_2_quest_01",text:"All branches and player choices that impact the quest, and their consequences, are detailed in full.",hint:null},{id:"quest_dialogue_2_quest_02",text:"The salient NPCs are described, detailing their origins and motivations which cause them to behave the way they are depicted as doing.",hint:null},{id:"quest_dialogue_2_quest_03",text:"The emotional journey the player experiences in the quest is communicated by the documentation (this may be implicit).",hint:null},{id:"quest_dialogue_2_quest_04",text:"The quest has been implemented into the game and can be completed.",hint:null},{id:"quest_dialogue_2_quest_05",text:"QA checks for this quest have been added to the QAMC template.",hint:null},{id:"quest_dialogue_2_quest_06",text:"The quest's progress is saved between sessions.",hint:null}],dialogueChecklist:[{id:"quest_dialogue_2_dial_01",text:"The tone and style are consistent with the rest of the game.",hint:null},{id:"quest_dialogue_2_dial_02",text:"There are numerous dialogue options for the player, even if they do not significantly impact the story.",hint:null},{id:"quest_dialogue_2_dial_03",text:"The dialogue and relevant NPCs are implemented in the game.",hint:null}],standards:[]},{index:3,name:"Ship",description:"Ready to be deployed. It passes all TRC/TCR tests and has no memory leaks. All assets are polished.",advice:"For the final pass, visuals and balance need to be tuned, ensuring the final product's quality. Quality is key here.",questChecklist:[{id:"quest_dialogue_3_quest_01",text:"Quest title and summary are updated/documented, based on the in-engine implementation.",hint:null},{id:"quest_dialogue_3_quest_02",text:"Quest & dialogue design doc embedded on this card (Google Doc section).",hint:"Flow charts stay on the Miro board; the doc itself lives on the card."}],dialogueChecklist:[{id:"quest_dialogue_3_dial_01",text:"If a dialogue choice by the player does not create a branch in the conversation, each choice instead gives the player different karma.",hint:'E.g. saying "Maybe not" and "of course not!" might lead to the same response from an NPC.'},{id:"quest_dialogue_3_dial_02",text:"The amounts of karma granted by dialogue choices in the quest are balanced.",hint:null},{id:"quest_dialogue_3_dial_03",text:"Content Compliance with Age Ratings confirmed (IARC).",hint:"Confirm the asset meets the required age rating thresholds (e.g., gore, violence, sexuality, nudity)."},{id:"quest_dialogue_3_dial_04",text:"Licensing and Accreditation confirmed.",hint:"Ensure all licensing and accreditation are secured, documented in the wiki, and credits are properly attributed."}],standards:[]}]},characters:{key:"characters",label:"Characters",color:"#f59e0b",stages:[{index:0,name:"Prototype",description:"A prototype demonstrates potential value. Assets are for demonstration purposes, and the game only runs on development PCs.",advice:"Just get the skeleton correct and working. Get the minimum functionality as requested by the Product Owner. Speed is the key.",traditionalChecklist:[{id:"characters_0_trad_01",text:"Design concept has been approved by a designer and a page for the character is on the wiki with minimal, critical details.",hint:null},{id:"characters_0_trad_02",text:"The character's design is aligned with our goals and standards for art direction.",hint:null},{id:"characters_0_trad_03",text:"References have been gathered to represent the final product along with a reference board, present on Miro, embedded on wiki.",hint:null},{id:"characters_0_trad_04",text:"Placeholder Manny/Quinn blueprint is added in-game with a unique colour.",hint:null},{id:"characters_0_trad_05",text:"Character blueprint has animation blueprint linked and is able to perform all necessary locomotion and action animations.",hint:null},{id:"characters_0_trad_06",text:"Character present in a test level.",hint:null}],metapipeChecklist:[{id:"characters_0_meta_01",text:"Design concept has been approved by a designer and a page for the character is on the wiki with minimal, critical details.",hint:null},{id:"characters_0_meta_02",text:"References have been gathered to represent the final product along with a reference board, present on Miro, embedded on wiki.",hint:null},{id:"characters_0_meta_03",text:"Placeholder Manny/Quinn blueprint is added in-game with a unique colour.",hint:null},{id:"characters_0_meta_04",text:"Character blueprint has animation blueprint linked and is able to perform all necessary locomotion and action animations.",hint:null},{id:"characters_0_meta_05",text:"Character present in a test level.",hint:null}],standards:[]},{index:1,name:"Internal Demo",description:"Demonstrates feature value and identifies areas that need to be polished before the feature can be shown internally. The game runs on target debug platforms with lower than shippable frame rates.",advice:'This is the first pass on the character, so the mesh should be representative of the final version. Think: "Dirt Road". Speed is the key.',traditionalChecklist:[{id:"characters_1_trad_01",text:"A simple representative mesh that provides the character's silhouette.",hint:null},{id:"characters_1_trad_02",text:"Simple, flat representative textures that provide the main colours/colourway.",hint:null},{id:"characters_1_trad_03",text:"Optimised simple collisions modelled based on the character's mesh.",hint:"ACF requires this for accurate hit detection."},{id:"characters_1_trad_04",text:"Character blueprint has animation blueprint linked and is able to perform all necessary locomotion and action animations.",hint:null}],metapipeChecklist:[{id:"characters_1_meta_01",text:"A base MetaHuman character created and added to the project.",hint:null},{id:"characters_1_meta_02",text:"Standard MetaHuman textures with no additional details at this stage.",hint:null},{id:"characters_1_meta_03",text:"Optimised simple collisions modelled based on the character's mesh.",hint:"ACF requires this for accurate hit detection."},{id:"characters_1_meta_04",text:"Character blueprint has animation blueprint linked and is able to perform all necessary locomotion and action animations.",hint:null}],standards:[]},{index:2,name:"External Demo",description:"Demonstrates demo quality (90% assets, not all TRC/TCR requirements). The target frame rate and hardware resource budgets are met.",advice:'This is the second pass on the character. Hair sim, cloth sim and optimisation does not need to be done at this point. Think: "Gravel Road". Speed and quality is the key.',traditionalChecklist:[{id:"characters_2_trad_01",text:"A retopologised, game-ready mesh is created and is in engine. Mesh will have high quality bakes, and show attributes from the high poly sculpt.",hint:null},{id:"characters_2_trad_02",text:"Game-ready mesh properly UV unwrapped. This requires custom UV unwrapping (no automatic) and adheres to performance budgets.",hint:null},{id:"characters_2_trad_03",text:"Flat colour representative textures. Ideally using generated/smart materials in Substance or adding colour to materials in engine.",hint:null},{id:"characters_2_trad_04",text:"Material set up in engine with correct texture maps using basic set up (Base, Normal, AO packed map).",hint:null},{id:"characters_2_trad_05",text:"Skin weighting is completed to a high level, with no major deformations that drastically alter the silhouette when the character is moving.",hint:null}],metapipeChecklist:[{id:"characters_2_meta_01",text:"Custom MetaHuman has been added to the project successfully.",hint:null},{id:"characters_2_meta_02",text:"Custom MetaHuman has the correct topology.",hint:null},{id:"characters_2_meta_03",text:"Standard MetaHuman textures set up in the correct blueprint locations.",hint:null},{id:"characters_2_meta_04",text:"Skin weighting is completed to a high level, with no major deformations that drastically alter the silhouette when the character is moving.",hint:null}],standards:[{id:"characters_2_std_01",text:"Live retargeter (if used) is functional to a high standard and accounts for offsets that may differ between actions.",hint:null},{id:"characters_2_std_02",text:"Check that masks and accessories are aligned correctly.",hint:null},{id:"characters_2_std_03",text:"QA checks for this asset have been added to the QAMC template.",hint:null}]},{index:3,name:"Ship",description:"Ready to be deployed. It passes all TRC/TCR tests and has no memory leaks. All assets are polished.",advice:"This is the final pass on the character. Quality is the key.",traditionalChecklist:[{id:"characters_3_trad_01",text:"Any external hair/groom/alembic assets have been brought into engine and optimised using hair cards or generated LODs.",hint:null},{id:"characters_3_trad_02",text:"Hair sim and cloth sim have been generated in engine and tweaks have been made to ensure they work correctly. This is to be tested with various animations and areas in the level to ensure functionality is consistent.",hint:null},{id:"characters_3_trad_03",text:"LODs have been tested for functionality within the level.",hint:null},{id:"characters_3_trad_04",text:"Content Compliance with Age Ratings confirmed (IARC).",hint:"Confirm the asset meets the required age rating thresholds (e.g., gore, violence, sexuality, nudity)."},{id:"characters_3_trad_05",text:"Licensing and Accreditation confirmed.",hint:"Ensure all licensing and accreditation are secured, documented in the wiki, and credits are properly attributed."}],metapipeChecklist:[{id:"characters_3_meta_01",text:"Any external hair/groom/alembic assets have been brought into engine and optimised using hair cards or generated LODs.",hint:null},{id:"characters_3_meta_02",text:"Hair sim and cloth sim have been generated in engine and tweaks have been made to ensure they work correctly. This is to be tested with various animations and areas in the level to ensure functionality is consistent.",hint:null},{id:"characters_3_meta_03",text:"LODs have been tested for functionality within the level.",hint:null},{id:"characters_3_meta_04",text:"Content Compliance with Age Ratings confirmed (IARC).",hint:"Confirm the asset meets the required age rating thresholds (e.g., gore, violence, sexuality, nudity)."},{id:"characters_3_meta_05",text:"All documentation is up to date and of a high quality.",hint:null},{id:"characters_3_meta_06",text:"Licensing and Accreditation confirmed.",hint:"Ensure all licensing and accreditation are secured, documented in the wiki, and credits are properly attributed."},{id:"characters_3_meta_07",text:"Check that masks and accessories are aligned correctly.",hint:"The positioning may change if the animations have been retargeted to a new skeleton."},{id:"characters_3_meta_08",text:"Polished textures and material shader(s) are produced to a high standard.",hint:"All placeholder textures replaced with final textures."},{id:"characters_3_meta_09",text:"Advanced materials set up in engine that are assigned as material instances derived from master materials within the material hierarchy.",hint:null},{id:"characters_3_meta_10",text:"Texture budgets met and reasonably optimised within performance budgets.",hint:"Texture size clamping pass."},{id:"characters_3_meta_11",text:"Character's hair sim and cloth sim have been generated in engine, tweaks have been made to ensure they work correctly and optimised within performance budgets.",hint:null},{id:"characters_3_meta_12",text:"Hair or fur (strands and cards) have been tested and optimised within performance budgets.",hint:null},{id:"characters_3_meta_13",text:"LODs have been tested and optimised within performance budgets.",hint:null},{id:"characters_3_meta_14",text:"Final SFX & VFX are required, replacing any placeholders.",hint:"Everything needed is present to sell the effect to players."},{id:"characters_3_meta_15",text:"QA tested inside Unreal Editor (PIE).",hint:'All severity A, B & C bugs resolved, with unresolved severity D logged appropriately in the QA backlog and linked to this card — use "+ Log QA item".'},{id:"characters_3_meta_16",text:"Passes relevant TRC checks for shipping on the Target Platform(s).",hint:"Fails if TRC fails, e.g. memory leak."}],standards:[{id:"characters_3_std_01",text:"All files exported to correct location in Perforce.",hint:"Ensure correct folder structure and naming convention before export."},{id:"characters_3_std_02",text:"Model exported as an FBX.",hint:"Ensure FBX.2020.2 or above for UE5."},{id:"characters_3_std_03",text:"Files imported into the Unreal project in the correct location.",hint:"Ensure correct folder structure and naming convention before importing."}]}]},cinematics:{key:"cinematics",label:"Cinematics",color:"#fb7185",stages:[{index:0,name:"Prototype",description:"A prototype demonstrates potential value. Assets are for demonstration purposes, and the game only runs on development PCs.",advice:"This stage is all about iteration and speed. Ideas need to be shared and sketched quickly to pin down a final direction for the cinematic. No work needs to be done in-engine until the end of this stage. Get the placeholder in the engine — don't worry about the final output such as animation clipping etc. Speed is the key.",checklist:[{id:"cinematics_0_check_01",text:"Pitch and concept have been agreed with a Designer.",hint:null},{id:"cinematics_0_check_02",text:"A Miro board embedded on a basic wiki page has been set up for the cinematic.",hint:null},{id:"cinematics_0_check_03",text:"A storyboard has been created and approved by a Designer, including sketches and brief descriptions.",hint:null},{id:"cinematics_0_check_04",text:"A shot list with key animation poses and timings has been uploaded to the Miro board.",hint:null},{id:"cinematics_0_check_05",text:"Key references for hero assets and for the general feel of the cinematic have been uploaded to the Miro board.",hint:null}],standards:[{id:"cinematics_0_std_01",text:"All files exported to correct location — ensure correct folder structure and naming convention before export.",hint:null},{id:"cinematics_0_std_02",text:"Where possible, actors should be spawnable.",hint:null},{id:"cinematics_0_std_03",text:"No content is stored in Developer folders.",hint:null},{id:"cinematics_0_std_04",text:"Aspect ratio should be consistent with other cinematics.",hint:null},{id:"cinematics_0_std_05",text:"Relevant files on Google Drive are embedded on the Miro board.",hint:null}]},{index:1,name:"Internal Demo",description:"Demonstrates feature value and identifies areas that need to be polished before the feature can be shown internally. The game runs on target debug platforms with lower than shippable frame rates.",advice:'This is the first pass on the animation. Think: "Dirt Road". Speed is the key.',checklist:[{id:"cinematics_1_check_01",text:"An in-engine animatic that represents the shot list and key animation poses has been created.",hint:"Placeholder assets are okay at this stage."},{id:"cinematics_1_check_02",text:"Key assets have been gathered and added to an appropriately named collection in-engine.",hint:null},{id:"cinematics_1_check_03",text:"The sequencer and cameras within are hierarchically organised in folders that conform to the correct naming conventions.",hint:null},{id:"cinematics_1_check_04",text:"Any missing assets that need to be made have been identified and created to LoF 1 standard for the appropriate pipeline.",hint:null},{id:"cinematics_1_check_05",text:"The sequencer can be viewed in a build.",hint:null},{id:"cinematics_1_check_06",text:"Basic lighting has been added that is representative of the feel of the cinematic.",hint:null},{id:"cinematics_1_check_07",text:"Only key SFX and VFX at this stage.",hint:"Placeholders OK."},{id:"cinematics_1_check_08",text:"QA tested inside Unreal Editor and in build.",hint:'All sev A bugs resolved, with sev B, C, and D bugs logged in the QA backlog and linked to this card — use "+ Log QA item".'},{id:"cinematics_1_check_09",text:"Miro board and wiki page are updated with any new material.",hint:null},{id:"cinematics_1_check_10",text:"The cinematic has been added to the Content list. The Content list is up to date.",hint:null}],standards:[{id:"cinematics_1_std_01",text:"All files exported to correct location — ensure correct folder structure and naming convention before export.",hint:null},{id:"cinematics_1_std_02",text:"Where possible, actors should be spawnable.",hint:null},{id:"cinematics_1_std_03",text:"No content is stored in Developer folders.",hint:null},{id:"cinematics_1_std_04",text:"Aspect ratio should be consistent with other cinematics.",hint:null},{id:"cinematics_1_std_05",text:"Relevant files on Google Drive are embedded on the Miro board.",hint:null}]},{index:2,name:"External Demo",description:"Demonstrates demo quality (90% assets, not all TRC/TCR requirements). The target frame rate and hardware resource budgets are met.",advice:'This is the second pass on animation — the final motion capture animation should be created, refined and implemented. Final polish does not have to be done at this stage. Think: "Gravel Road". Speed and quality is the key.',checklist:[{id:"cinematics_2_check_01",text:"Any assets being made for the cinematic are created to LoF 2 standard for the appropriate pipeline.",hint:null},{id:"cinematics_2_check_02",text:"Basic animations are set up and functional.",hint:null},{id:"cinematics_2_check_03",text:"All SFX and VFX placeholders are added.",hint:null},{id:"cinematics_2_check_04",text:"The cinematic is added to the QA master checklist template.",hint:null},{id:"cinematics_2_check_05",text:"QA tested in build.",hint:'All sev A and B bugs resolved, with sev C and D bugs logged in the QA backlog and linked to this card — use "+ Log QA item".'},{id:"cinematics_2_check_06",text:"Miro board, Content list, and wiki page are updated with any new material.",hint:null}],standards:[{id:"cinematics_2_std_01",text:"All files exported to correct location — ensure correct folder structure and naming convention before export.",hint:null},{id:"cinematics_2_std_02",text:"Where possible, actors should be spawnable.",hint:null},{id:"cinematics_2_std_03",text:"No content is stored in Developer folders.",hint:null},{id:"cinematics_2_std_04",text:"Aspect ratio should be consistent with other cinematics.",hint:null},{id:"cinematics_2_std_05",text:"Relevant files on Google Drive are embedded on the Miro board.",hint:null}]},{index:3,name:"Ship",description:"Ready to be deployed. It passes all TRC/TCR tests and has no memory leaks. All assets are polished.",advice:'This is the final pass on the animation. Optimisation and polish should be complete at this stage. Think: "Concrete Road". Quality is the key.',checklist:[{id:"cinematics_3_check_01",text:"Final lighting and camera shots.",hint:null},{id:"cinematics_3_check_02",text:"All animations are set up and entirely functional.",hint:null},{id:"cinematics_3_check_03",text:"Any assets being made for the cinematic are created to LoF 3 standard for the appropriate pipeline.",hint:null},{id:"cinematics_3_check_04",text:"Final SFX and VFX are added.",hint:null},{id:"cinematics_3_check_05",text:"QA tested inside Build on Target Platform(s).",hint:'All severity A, B & C bugs resolved, with unresolved severity D logged appropriately in the QA backlog and linked to this card — use "+ Log QA item".'},{id:"cinematics_3_check_06",text:"Miro board and wiki page are fully up to date, with screen recordings (optional) of the final media embedded on the Miro board.",hint:null},{id:"cinematics_3_check_07",text:"Content Compliance with Age Ratings confirmed (IARC).",hint:"Confirm the asset meets the required age rating thresholds (e.g., gore, violence, sexuality, nudity)."},{id:"cinematics_3_check_08",text:"Licensing and Accreditation confirmed.",hint:"Ensure all licensing and accreditation are secured, documented in the wiki, and credits are properly attributed."}],standards:[{id:"cinematics_3_std_01",text:"All files exported to correct location — ensure correct folder structure and naming convention before export.",hint:null},{id:"cinematics_3_std_02",text:"No content is stored in Developer folders.",hint:null},{id:"cinematics_3_std_03",text:"Where possible, actors should be spawnable.",hint:null},{id:"cinematics_3_std_04",text:"Aspect ratio should be consistent with other cinematics.",hint:null},{id:"cinematics_3_std_05",text:"Relevant files on Google Drive are embedded on the Miro board.",hint:null}]},{index:4,name:"Console Ship",description:"Ready to be deployed to consoles. It passes all TRC/TCR tests.",advice:"Test on the console, not on PC builds.",checklist:[{id:"cinematics_4_check_01",text:"Passes relevant TRC checks for shipping on the Target Platform(s).",hint:"Fails if TRC fails, e.g. memory leak."},{id:"cinematics_4_check_02",text:"QA tested inside Build on Target Platform(s).",hint:'All severity A, B & C bugs resolved, with unresolved severity D logged appropriately in the QA backlog and linked to this card — use "+ Log QA item".'}],standards:[]}]},system:{key:"system",label:"System / Feature / Mechanic",color:"#22c55e",stages:[{index:0,name:"Prototype",description:"A prototype demonstrates potential value. Assets are for demonstration purposes, and the game only runs on development PCs.",advice:"This is a throwaway. Just answer the key questions about whether the feature is viable. Speed is the key.",checklist:[{id:"system_0_check_01",text:"The core principles of the system or feature design are written up.",hint:null},{id:"system_0_check_02",text:"Discussed and agreed design intent (function and visual) with a Designer.",hint:null},{id:"system_0_check_03",text:"The prototype functionality should remove unknowns about the feature.",hint:null},{id:"system_0_check_04",text:"Operable inside of a prototype level.",hint:null},{id:"system_0_check_05",text:"Does not require visual, particle or sound effects.",hint:null},{id:"system_0_check_06",text:"Runs on dev PC (PIE).",hint:null}],standards:[]},{index:1,name:"Internal Demo",description:"Demonstrates feature value and identifies areas that need to be polished before the feature can be shown internally. The game runs on target debug platforms with lower than shippable frame rates.",advice:'A quick and dirty implementation. Think: "Dirt Road". Speed is the key.',checklist:[{id:"system_1_check_01",text:"Blueprint implementation with parts targeted for a C++ implementation identified.",hint:null},{id:"system_1_check_02",text:"Input functionality targets only keyboard and mouse.",hint:null},{id:"system_1_check_03",text:"Content created in main folders, no Dev folder content.",hint:null},{id:"system_1_check_04",text:"Operable inside of a prototype level.",hint:null},{id:"system_1_check_05",text:"Includes placeholder visual, particle and sound effects.",hint:null},{id:"system_1_check_06",text:"Runs on target debug platform (PC) with lower than shippable frame rates.",hint:null},{id:"system_1_check_07",text:"Passes a basic code review.",hint:null},{id:"system_1_check_08",text:"No circular dependencies.",hint:null},{id:"system_1_check_09",text:"All severity A bugs resolved, with unresolved severity B logged appropriately in the QA backlog and linked to this card.",hint:'Log QA items and automatically attach them to this card with "+ Log QA item".'}],standards:[]},{index:2,name:"External Demo",description:"Demonstrates demo quality (90% assets, not all TRC/TCR requirements). The target frame rate and hardware resource budgets are met.",advice:'Think: "Gravel Road". Speed and quality is the key.',checklist:[{id:"system_2_check_01",text:"Design document created, formalising the design essentials.",hint:null},{id:"system_2_check_02",text:"Tutorialise the system.",hint:null},{id:"system_2_check_03",text:"Follow code conventions for what should be C++ vs Blueprint.",hint:null},{id:"system_2_check_04",text:"Full input functionality for both keyboard/mouse (KBM) and gamepads (XBOX).",hint:null},{id:"system_2_check_05",text:"Optimised only if it is found to cause detriment to performance.",hint:null},{id:"system_2_check_06",text:"Content created in main folders, no Dev folder content.",hint:null},{id:"system_2_check_07",text:"Includes suitable (placeholder or final) visual, particle and sound effects.",hint:null},{id:"system_2_check_08",text:"Runs on lead development platform (PC) packaged.",hint:null},{id:"system_2_check_09",text:"Passes a code review.",hint:null},{id:"system_2_check_10",text:"Test cases added to the QA master checklist template.",hint:null},{id:"system_2_check_11",text:"Debug commands required for testing are present.",hint:null},{id:"system_2_check_12",text:"All severity A & B bugs resolved, with unresolved severity C logged appropriately in the QA backlog and linked to this card.",hint:'Log QA items and automatically attach them to this card with "+ Log QA item".'}],standards:[]},{index:3,name:"Ship",description:"Ready to be deployed. It passes all TRC/TCR tests and has no memory leaks. All assets are polished.",advice:'Think: "Concrete Road". Quality is the key.',checklist:[{id:"system_3_check_01",text:"The final state of the feature's design has been written up in a clear and concise format.",hint:null},{id:"system_3_check_02",text:"Improvements identified in relevant playtests have been made.",hint:null},{id:"system_3_check_03",text:"A user guide document has been created to support the feature.",hint:null},{id:"system_3_check_04",text:"Code performance is tested (benchmarked) and then optimised.",hint:null},{id:"system_3_check_05",text:"Content created in main folders, no Dev folder content.",hint:null},{id:"system_3_check_06",text:"Includes final visual, particle and sound effects.",hint:null},{id:"system_3_check_07",text:"Runs on all target platforms (PC) in a shipping build.",hint:null},{id:"system_3_check_08",text:"Passes a code review.",hint:null},{id:"system_3_check_09",text:"All severity A, B & C bugs resolved, with unresolved severity D logged appropriately in the QA backlog and linked to this card.",hint:'Log QA items and automatically attach them to this card with "+ Log QA item".'},{id:"system_3_check_10",text:"Content Compliance with Age Ratings confirmed (IARC).",hint:"Confirm the asset meets the required age rating thresholds (e.g., gore, violence, sexuality, nudity)."},{id:"system_3_check_11",text:"Licensing and Accreditation confirmed.",hint:"Ensure all licensing and accreditation are secured, documented in the wiki, and credits are properly attributed."}],standards:[]},{index:4,name:"Console Ship",description:"Ready to be deployed to consoles. It passes all TRC/TCR tests.",advice:"Test on the console, not on PC builds.",checklist:[{id:"system_4_check_01",text:"Passes relevant TRC/TCR tests for shipping on the Target Platform(s).",hint:null},{id:"system_4_check_02",text:"QA tested inside Build on Target Platform(s).",hint:'All severity A, B & C bugs resolved, with unresolved severity D logged appropriately in the QA backlog and linked to this card — use "+ Log QA item".'}],standards:[]}]},actions:{key:"actions",label:"Actions (Verbs / Spells)",color:"#6366f1",stages:[{index:0,name:"Prototype",description:"A prototype demonstrates potential value. Assets are for demonstration purposes, and the game only runs on development PCs.",advice:"This is a throwaway. Just answer the key questions about whether the action is viable. Speed is the key.",checklist:[{id:"actions_0_check_01",text:"The core principles of the action or spell design are written up.",hint:null},{id:"actions_0_check_02",text:"Discussed and agreed design intent (function and visual) with a Designer.",hint:null},{id:"actions_0_check_03",text:"The prototype functionality should remove unknowns about the action.",hint:null},{id:"actions_0_check_04",text:"Operable inside of a prototype level.",hint:null},{id:"actions_0_check_05",text:"Does not require visual, particle or sound effects.",hint:null},{id:"actions_0_check_06",text:"Runs on dev PC (PIE).",hint:null}],standards:[]},{index:1,name:"Internal Demo",description:"Demonstrates feature value and identifies areas that need to be polished before the feature can be shown internally. The game runs on target debug platforms with lower than shippable frame rates.",advice:'A quick and dirty implementation. Think: "Dirt Road". Speed is the key.',checklist:[{id:"actions_1_check_01",text:"Blueprint implementation with parts targeted for a C++ implementation identified.",hint:null},{id:"actions_1_check_02",text:"Input functionality targets only keyboard and mouse.",hint:null},{id:"actions_1_check_03",text:"Content created in main folders, no Dev folder content.",hint:null},{id:"actions_1_check_04",text:"Operable inside of a prototype level.",hint:null},{id:"actions_1_check_05",text:"Includes placeholder visual, particle and sound effects.",hint:null},{id:"actions_1_check_06",text:"Runs on target debug platform (PC) with lower than shippable frame rates.",hint:null},{id:"actions_1_check_07",text:"Passes a basic code review.",hint:null},{id:"actions_1_check_08",text:"No circular dependencies.",hint:null},{id:"actions_1_check_09",text:"All severity A bugs resolved, with unresolved severity B logged appropriately in the QA backlog and linked to this card.",hint:'Log QA items and automatically attach them to this card with "+ Log QA item".'}],standards:[]},{index:2,name:"External Demo",description:"Demonstrates demo quality (90% assets, not all TRC/TCR requirements). The target frame rate and hardware resource budgets are met.",advice:'Think: "Gravel Road". Speed and quality is the key.',checklist:[{id:"actions_2_check_01",text:"Design document created, formalising the design essentials.",hint:null},{id:"actions_2_check_02",text:"Tutorialise the action.",hint:null},{id:"actions_2_check_03",text:"Follow code conventions for what should be C++ vs Blueprint.",hint:null},{id:"actions_2_check_04",text:"Full input functionality for both keyboard/mouse (KBM) and gamepads (XBOX).",hint:null},{id:"actions_2_check_05",text:"Optimised only if it is found to cause detriment to performance.",hint:null},{id:"actions_2_check_06",text:"Content created in main folders, no Dev folder content.",hint:null},{id:"actions_2_check_07",text:"Includes suitable (placeholder or final) visual, particle and sound effects.",hint:null},{id:"actions_2_check_08",text:"Runs on lead development platform (PC) packaged.",hint:null},{id:"actions_2_check_09",text:"Passes a code review.",hint:null},{id:"actions_2_check_10",text:"Test cases added to the QA master checklist template.",hint:null},{id:"actions_2_check_11",text:"Debug commands required for testing are present.",hint:null},{id:"actions_2_check_12",text:"All severity A & B bugs resolved, with unresolved severity C logged appropriately in the QA backlog and linked to this card.",hint:'Log QA items and automatically attach them to this card with "+ Log QA item".'}],standards:[]},{index:3,name:"Ship",description:"Ready to be deployed. It passes all TRC/TCR tests and has no memory leaks. All assets are polished.",advice:'Think: "Concrete Road". Quality is the key.',checklist:[{id:"actions_3_check_01",text:"The final state of the action's design has been written up in a clear and concise format.",hint:null},{id:"actions_3_check_02",text:"Improvements identified in relevant playtests have been made.",hint:null},{id:"actions_3_check_03",text:"A user guide document has been created to support the action.",hint:null},{id:"actions_3_check_04",text:"Code performance is tested (benchmarked) and then optimised.",hint:null},{id:"actions_3_check_05",text:"Content created in main folders, no Dev folder content.",hint:null},{id:"actions_3_check_06",text:"Includes final visual, particle and sound effects.",hint:null},{id:"actions_3_check_07",text:"Runs on all target platforms (PC) in a shipping build.",hint:null},{id:"actions_3_check_08",text:"Passes a code review.",hint:null},{id:"actions_3_check_09",text:"All severity A, B & C bugs resolved, with unresolved severity D logged appropriately in the QA backlog and linked to this card.",hint:'Log QA items and automatically attach them to this card with "+ Log QA item".'},{id:"actions_3_check_10",text:"Content Compliance with Age Ratings confirmed (IARC).",hint:"Confirm the asset meets the required age rating thresholds (e.g., gore, violence, sexuality, nudity)."},{id:"actions_3_check_11",text:"Licensing and Accreditation confirmed.",hint:"Ensure all licensing and accreditation are secured, documented in the wiki, and credits are properly attributed."}],standards:[]},{index:4,name:"Console Ship",description:"Ready to be deployed to consoles. It passes all TRC/TCR tests.",advice:"Test on the console, not on PC builds.",checklist:[{id:"actions_4_check_01",text:"Passes relevant TRC/TCR tests for shipping on the Target Platform(s).",hint:null},{id:"actions_4_check_02",text:"QA tested inside Build on Target Platform(s).",hint:'All severity A, B & C bugs resolved, with unresolved severity D logged appropriately in the QA backlog and linked to this card — use "+ Log QA item".'}],standards:[]}]},tech_art:{key:"tech_art",label:"Tech Art & VFX",color:"#14b8a6",stages:[{index:0,name:"Prototype",description:"A prototype demonstrates potential value. Assets are for demonstration purposes, and the game only runs on development PCs.",advice:"This is a throwaway and will most often be remade or removed. Just get it into the engine. Speed is the key.",checklist:[{id:"tech_art_0_check_01",text:"A minimal design specification has been exchanged between Dev/Designer/Artist and Tech Artist.",hint:null},{id:"tech_art_0_check_02",text:"Clearly show research, feedback and iterative development towards a final design in Miro.",hint:null},{id:"tech_art_0_check_03",text:"Miro board embedded on a basic wiki page, with Share URL on the card.",hint:null},{id:"tech_art_0_check_04",text:"Discussed and agreed final design with relevant Design Leads.",hint:null},{id:"tech_art_0_check_05",text:"Deliverables broken down into sub-items on this card, each tagged with Priority (MoSCoW) and Risk.",hint:"Add conditions under the checklist lines, then use the prio/risk pickers on each row."}],standards:[{id:"tech_art_0_std_01",text:"All files exported to correct location in Perforce.",hint:"Ensure correct folder structure and naming convention before export."},{id:"tech_art_0_std_02",text:"Files imported into Unreal project in correct location.",hint:"Ensure correct folder structure and naming convention before importing."},{id:"tech_art_0_std_03",text:"Features designed and programmed to matching LoF standard.",hint:null}]},{index:1,name:"Internal Demo",description:"Demonstrates feature value and identifies areas that need to be polished before the feature can be shown internally. The game runs on target debug platforms with lower than shippable frame rates.",advice:'This mesh should be representative of all aspects of the final design; assets should be easy to swap, alter or remove. Think: "Dirt Road". Speed is the key.',checklist:[{id:"tech_art_1_check_01",text:'Tool or VFX demonstrated in-engine with the features tagged "Must" on this card.',hint:null},{id:"tech_art_1_check_02",text:"Updates to reference boards and design changes reflected on Miro board.",hint:null},{id:"tech_art_1_check_03",text:"SFX & additional VFX placeholders may be added.",hint:null},{id:"tech_art_1_check_04",text:"QA tested inside Unreal Editor (PIE) with all severity A bugs resolved.",hint:null}],standards:[{id:"tech_art_1_std_01",text:"Files exported to correct Perforce location with proper naming conventions.",hint:null},{id:"tech_art_1_std_02",text:"Files imported to Unreal project correctly.",hint:null},{id:"tech_art_1_std_03",text:"Features programmed to matching LoF standard.",hint:null}]},{index:2,name:"External Demo",description:"Demonstrates demo quality (90% assets, not all TRC/TCR requirements). The target frame rate and hardware resource budgets are met.",advice:'The mesh should be entirely representative of the final design; placeholder textures created to sell the visual. Think: "Gravel Road". Speed and quality is the key.',checklist:[{id:"tech_art_2_check_01",text:'Tool or VFX includes the features tagged "Must" and "Should" on this card.',hint:null},{id:"tech_art_2_check_02",text:'"Could Have" features assessed and committed as part of "Conditions of Signoff" for LoF 3.',hint:null},{id:"tech_art_2_check_03",text:"Miro board updated with design changes.",hint:null},{id:"tech_art_2_check_04",text:"SFX & VFX required; suitable placeholders acceptable.",hint:null},{id:"tech_art_2_check_05",text:"VFX attached to existing content if necessary and demonstrable in build.",hint:null},{id:"tech_art_2_check_06",text:"QA tested in Build with all sev A & B bugs resolved.",hint:null},{id:"tech_art_2_check_07",text:"QA checks added to QAMC template.",hint:null}],standards:[{id:"tech_art_2_std_01",text:"Files exported to correct Perforce location.",hint:null},{id:"tech_art_2_std_02",text:"Files imported to Unreal project correctly.",hint:null},{id:"tech_art_2_std_03",text:"Features programmed to matching LoF standard.",hint:null}]},{index:3,name:"Ship",description:"Ready to be deployed. It passes all TRC/TCR tests and has no memory leaks. All assets are polished.",advice:"Quality is key. This is the final pass and will need thorough third-party review.",checklist:[{id:"tech_art_3_check_01",text:'Tool or VFX includes the features tagged "Must" and "Should" on this card.',hint:null},{id:"tech_art_3_check_02",text:'"Could Have" features previously agreed as "Conditions of Signoff" are demonstrable.',hint:null},{id:"tech_art_3_check_03",text:"Miro board reflects all design updates.",hint:null},{id:"tech_art_3_check_04",text:"Reasonably optimised within performance budgets with profiling completed.",hint:null},{id:"tech_art_3_check_05",text:"Final SFX & VFX required, replacing all placeholders.",hint:null},{id:"tech_art_3_check_06",text:"QA tested in Build with all sev A, B & C bugs resolved.",hint:null},{id:"tech_art_3_check_07",text:"Content Compliance with Age Ratings confirmed (IARC).",hint:"Confirm the asset meets the required age rating thresholds (e.g., gore, violence, sexuality, nudity)."},{id:"tech_art_3_check_08",text:"Licensing and Accreditation confirmed.",hint:"Ensure all licensing and accreditation are secured, documented in the wiki, and credits are properly attributed."}],standards:[{id:"tech_art_3_std_01",text:"Files exported to correct Perforce location.",hint:null},{id:"tech_art_3_std_02",text:"Files imported to Unreal project correctly.",hint:null},{id:"tech_art_3_std_03",text:"Features programmed to matching LoF standard.",hint:null}]}]},"2d_asset":{key:"2d_asset",label:"2D Assets",color:"#38bdf8",stages:[{index:0,name:"Prototype",description:"A prototype demonstrates potential value. Assets are for demonstration purposes, and do not require optimisation to run on low-spec computers.",advice:"Focus on speed over perfection since this version will be replaced.",checklist:[{id:"2d_asset_0_check_01",text:"Create a simple mockup (paper or digital).",hint:null}],standards:[]},{index:1,name:"Internal Demo",description:"Demonstrates feature value and identifies areas that need to be polished before the feature can be shown internally.",advice:'Don\'t over-invest in polish. Think: "Dirt Road". Speed is the key.',checklist:[{id:"2d_asset_1_check_01",text:"Add placeholder texture assets to the correct engine location for testing.",hint:null}],standards:[]},{index:2,name:"External Demo",description:"Demonstrates demo quality (90% assets, not all TRC/TCR requirements).",advice:'Implement near-final design. Think: "Gravel Road". Quality becomes important.',checklist:[{id:"2d_asset_2_check_01",text:"Create digital asset at correct measurements and art style.",hint:null},{id:"2d_asset_2_check_02",text:"Import to proper location.",hint:null},{id:"2d_asset_2_check_03",text:"Export as PNG/SVG based on usage.",hint:null},{id:"2d_asset_2_check_04",text:"Follow naming conventions.",hint:null},{id:"2d_asset_2_check_05",text:"Place in correct Unreal folder structure.",hint:null},{id:"2d_asset_2_check_06",text:"QA tested in Unreal.",hint:null},{id:"2d_asset_2_check_07",text:"Add QA checks to QAMC template.",hint:null}],standards:[]},{index:3,name:"Ship",description:"Ready to be deployed. It passes all TRC/TCR tests and has no memory leaks.",advice:'Final polish required. Think: "Concrete Road". Quality is paramount.',checklist:[{id:"2d_asset_3_check_01",text:"Refine based on player feedback.",hint:null},{id:"2d_asset_3_check_02",text:"Verify final art style alignment.",hint:null},{id:"2d_asset_3_check_03",text:"Content Compliance with Age Ratings confirmed (IARC).",hint:"Confirm the asset meets the required age rating thresholds (e.g., gore, violence, sexuality, nudity)."},{id:"2d_asset_3_check_04",text:"Licensing and Accreditation confirmed.",hint:"Ensure all licensing and accreditation are secured, documented in the wiki, and credits are properly attributed."}],standards:[]}]},none:{key:"none",label:"No pipeline (ops / infra)",color:"#64748b",stages:[]},rd:{key:"rd",label:"R&D",color:"#64748b",stages:[]},web:{key:"web",label:"Web / Platform",color:"#38BDF8",stages:[{index:0,name:"R&D",description:"Resolves whether we know what to build and whether it is worth building — vision, scope, and the tasks required — before any code is written. Rare: most work skips straight to Build-out with a spec agreed in conversation. This stage exists for genuinely new/uncertain scope only.",advice:"Keep this light — a shared answer to what we are building and why, not a polished document. If scope turns out bigger than expected, it is fine to shelve and revisit later rather than push on regardless.",checklist:[{id:"web_0_check_01",text:"Vision agreed: what is being asked for, what is possible to deliver, and do the two match?",hint:null},{id:"web_0_check_02",text:"Scope agreed: how much, how big, how far — and what is explicitly NOT included.",hint:null},{id:"web_0_check_03",text:"Tasks/steps required are listed.",hint:null},{id:"web_0_check_04",text:"Checked for hidden dependencies.",hint:'"Are there any hidden dependencies in the items identified?"'},{id:"web_0_check_05",text:"For a brand-new module: a light mockup or sketch exists to point at.",hint:"Not required for a feature on an existing module — exploring in chat is enough when the platform context already exists."}],standards:[]},{index:1,name:"Build-out",description:"Takes the agreed spec to a shipped, tested feature or system. No further durability gate after this — once it is live, this round is done.",advice:"Write tests as you build, not after. If new requirements surface before this ships, rescope this round in place rather than shipping partial work — that is not a new round yet, since nothing has shipped.",checklist:[{id:"web_1_check_01",text:"Implementation matches the agreed spec / acceptance criteria.",hint:null},{id:"web_1_check_02",text:"Automated tests written for the new behaviour.",hint:null},{id:"web_1_check_03",text:"Full test suite passing (`npm test`).",hint:null},{id:"web_1_check_04",text:"Verified working end-to-end.",hint:"Browser-checked against the real flow, not just unit tests."},{id:"web_1_check_05",text:"Shipped to production.",hint:null},{id:"web_1_check_06",text:"Card links back to the spec/doc this came from.",hint:null}],standards:[]}]}};e.s(["lofDefinitions",0,t])}]);